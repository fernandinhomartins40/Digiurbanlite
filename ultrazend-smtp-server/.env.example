# UltraZend SMTP Server - Environment Variables

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ultrazend_smtp?schema=public"

# SMTP Server Configuration
SMTP_HOSTNAME="mail.ultrazend.com"
SMTP_MX_PORT=25
SMTP_SUBMISSION_PORT=587

# Security
SMTP_AUTH_REQUIRED=true
SMTP_TLS_ENABLED=true
SMTP_CERT_PATH="/path/to/cert.pem"
SMTP_KEY_PATH="/path/to/key.pem"

# Limits
SMTP_MAX_CONNECTIONS=100
SMTP_MAX_MESSAGE_SIZE=52428800

# Logging
LOG_LEVEL="info"
