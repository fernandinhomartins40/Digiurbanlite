// ========================================
// SLA E PRAZOS AUTOMÁTICOS
// ========================================

model ProtocolSLA {
  id         String @id @default(cuid())
  protocolId String @unique

  // Prazos
  startDate       DateTime
  expectedEndDate DateTime
  actualEndDate   DateTime?

  // Pausa (ex: aguardando cidadão)
  isPaused        Boolean   @default(false)
  pausedAt        DateTime?
  pausedReason    String?
  totalPausedDays Int       @default(0)

  // Status
  isOverdue   Boolean @default(false)
  daysOverdue Int     @default(0)

  // Cálculo
  workingDays  Int // Dias úteis
  calendarDays Int // Dias corridos

  updatedAt DateTime @updatedAt

  protocol ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@map("protocol_sla")
}

// ========================================
// FIM DO SISTEMA SIMPLIFICADO
// ========================================

model Notification {
  id         String    @id @default(cuid())
  userId     String? // Admin/servidor
  citizenId  String? // Cidadão
  title      String
  message    String
  type       String    @default("INFO")
  channel    String    @default("WEB")
  isRead     Boolean   @default(false)
  sentAt     DateTime?
  readAt     DateTime?
  protocolId String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  user    User?             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  citizen Citizen?          @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  logs    NotificationLog[]

  @@index([userId])
  @@index([citizenId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Push Subscription para Web Push API
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String? // Admin/servidor
  citizenId String? // Cidadão
  endpoint  String   @unique
  p256dh    String // Chave pública
  auth      String // Chave de autenticação
  userAgent String?
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())

  user    User?    @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  citizen Citizen? @relation("CitizenPushSubscriptions", fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([citizenId])
  @@index([endpoint])
  @@map("push_subscriptions")
}

// Preferências de notificações
model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String? @unique
  citizenId String? @unique

  // Canais habilitados
  webEnabled   Boolean @default(true)
  pushEnabled  Boolean @default(false)
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  // Tipos de notificação (JSON com granularidade)
  preferences Json @default("{}")
  // Exemplo: { "protocol_status": { "web": true, "push": true, "email": false } }

  // Horário de silêncio
  quietHoursStart String? // "22:00"
  quietHoursEnd   String? // "08:00"

  // Resumo diário
  dailyDigest     Boolean @default(false)
  dailyDigestTime String? // "08:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)
  citizen Citizen? @relation("CitizenNotificationPreferences", fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([citizenId])
  @@map("notification_preferences")
}

// Log de notificações enviadas (auditoria + retry)
model NotificationLog {
  id             String  @id @default(cuid())
  notificationId String? // Referência à Notification se existir
  userId         String?
  citizenId      String?

  type    String // PROTOCOL_STATUS, DOCUMENT_APPROVED, etc
  channel String // WEB, PUSH, EMAIL, SMS
  status  String // PENDING, SENT, FAILED, DELIVERED, CLICKED

  payload Json // Dados da notificação
  error   String? // Mensagem de erro se falhou

  sentAt      DateTime?
  deliveredAt DateTime?
  clickedAt   DateTime?

  createdAt DateTime @default(now())

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([citizenId])
  @@index([type])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("notification_logs")
}

model CitizenTransferRequest {
