// ✅ NOVA TABELA: Configurações de Atendimento por Unidade
model ConfiguracaoAtendimento {
  id        String @id @default(cuid())
  unidadeId String @unique

  // Configurações de Senhas e Filas
  prefixoSenha              String  @default("A") // Prefixo para senhas (A, B, C, etc.)
  reiniciarSenhaDiariamente Boolean @default(true)
  senhaInicial              Int     @default(1) // Número inicial das senhas

  // Horários de Funcionamento
  horaAberturaAtendimento   String @default("07:00")
  horaFechamentoAtendimento String @default("17:00")
  diasFuncionamento         Json? // Array de dias da semana (1-7, se vazio = todos)

  // Configurações de Triagem
  triagemObrigatoria Boolean @default(true)
  tempoMedioTriagem  Int     @default(10) // Minutos

  // Configurações de Agendamento
  permitirAgendamento     Boolean @default(true)
  limiteAgendamentoDias   Int     @default(30) // Quantos dias de antecedência permitir
  permitirCancelamento    Boolean @default(true)
  limiteCancelamentoHoras Int     @default(24) // Horas antes da consulta

  // Configurações de Atendimento
  tempoMedioConsulta Int     @default(30) // Minutos
  permitirEncaixe    Boolean @default(true)
  limiteEncaixesDia  Int     @default(5)

  // Notificações
  enviarSMSLembrete      Boolean @default(false)
  horasAntesLembrete     Int     @default(24)
  enviarEmailConfirmacao Boolean @default(false)

  // Configurações de Prioridade
  priorizarIdosos       Boolean @default(true)
  priorizarGestantes    Boolean @default(true)
  priorizarDeficientes  Boolean @default(true)
  idadeMinimaPrioridade Int     @default(60)

  // Outras configurações
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamento
  unidade UnidadeSaude @relation(fields: [unidadeId], references: [id])

  @@map("configuracoes_atendimento")
}

