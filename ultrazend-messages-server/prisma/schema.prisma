// MS-20+21: Gestão de Máquinas e Empréstimos

// ============================================================================
// ULTRAZEND MESSAGES - Sistema de Mensagens em Tempo Real
// ============================================================================

// ============================================
// ULTRAZEND MESSAGES - CORE
// ============================================

model MessageServer {
  id               String   @id @default(cuid())
  name             String // "DigiUrban Messages"
  hostname         String // messages.digiurban.com.br
  wsPort           Int      @default(9001)
  isActive         Boolean  @default(false)
  maxDailyMessages Int      @default(100000)
  enableEncryption Boolean  @default(false) // E2E encryption
  enableP2P        Boolean  @default(false) // Cidadão-Cidadão
  enableBroadcast  Boolean  @default(true) // Canais oficiais
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relacionamentos
  conversations Conversation[]
  channels      OfficialChannel[]
  logs          MessageLog[]
  stats         MessageStats[]

  @@map("message_servers")
}

// ============================================
// CONVERSAS 1:1 E P2P
// ============================================

model Conversation {
  id              String @id @default(cuid())
  messageServerId String

  // Participantes
  participant1Id   String
  participant1Type ParticipantType // CITIZEN ou SERVER
  participant2Id   String
  participant2Type ParticipantType // CITIZEN ou SERVER

  // Contexto (opcional - para vincular a protocolos)
  protocolId   String?
  departmentId String?

  // Tipo de conversa
  type ConversationType @default(SUPPORT) // SUPPORT, P2P, GROUP

  // Status
  status             ConversationStatus @default(ACTIVE)
  lastMessageAt      DateTime?
  lastMessagePreview String? // Preview da última mensagem

  // Contadores
  totalMessages Int @default(0)
  unreadCount1  Int @default(0) // Não lidas por participant1
  unreadCount2  Int @default(0) // Não lidas por participant2

  // Metadados
  metadata Json?

  // "Apagar para mim" — mensagens com sentAt < clearedAtN ficam ocultas para participante N
  clearedAt1 DateTime? // Timestamp de "apagar para mim" do participant1
  clearedAt2 DateTime? // Timestamp de "apagar para mim" do participant2

  // "Excluir conversa" por participante — oculta a conversa inteira para quem excluiu
  deletedAt1 DateTime? // Timestamp de exclusão pelo participant1
  deletedAt2 DateTime? // Timestamp de exclusão pelo participant2

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  // Bot-specific fields (REFATORADO - source of truth é FlowExecution)
  isBotConversation       Boolean  @default(false)
  activeFlowExecutionId   String?  @unique // FK para execução ativa do bot

  // Relacionamentos
  messageServer        MessageServer  @relation(fields: [messageServerId], references: [id], onDelete: Cascade)
  messages             Message[]
  activeFlowExecution  FlowExecution? @relation("ActiveFlowExecution", fields: [activeFlowExecutionId], references: [id], onDelete: SetNull)

  @@unique([participant1Id, participant1Type, participant2Id, participant2Type, protocolId])
  @@index([participant1Id, participant1Type, status])
  @@index([participant2Id, participant2Type, status])
  @@index([protocolId])
  @@index([status, lastMessageAt])
  @@index([isBotConversation, status])
  @@map("conversations")
}

enum ParticipantType {
  CITIZEN // Cidadão
  SERVER // Servidor público (User)
  SYSTEM // Sistema automático
}

enum ConversationType {
  SUPPORT // Suporte (cidadão <-> servidor)
  P2P // Peer-to-peer (cidadão <-> cidadão)
  GROUP // Grupo (futuro)
}

enum ConversationStatus {
  ACTIVE // Conversa ativa
  ARCHIVED // Arquivada pelo usuário
  CLOSED // Encerrada oficialmente
  BLOCKED // Bloqueada por violação
}

// ============================================
// MENSAGENS
// ============================================

model Message {
  id             String @id @default(cuid())
  conversationId String

  // Autor
  senderId   String
  senderType ParticipantType

  // Conteúdo
  content     String             @db.Text
  contentType MessageContentType @default(TEXT)

  // Anexos
  attachments Json? // Array de {url, type, name, size}

  // Mensagem citada/respondida
  replyToId String?

  // Status de entrega
  status      MessageStatus @default(SENT)
  sentAt      DateTime      @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  // Edição/Exclusão
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String? // ID de quem deletou

  // Metadados
  metadata Json? // IP, user-agent, location, etc

  // ✅ NOVO: Campos para mensagens de bot (analytics queryable)
  isBotMessage          Boolean  @default(false) // Mensagem gerada pelo bot
  botInteractionType    String? // 'menu', 'form', 'upload', 'location', 'flow_navigation'
  botSelectedOption     String? // ID da opção selecionada (para menus)
  botStructuredData     Json? // Dados estruturados originais (form, location, etc)
  botFlowNodeId         String? // ID do nodo que gerou/processou esta mensagem
  botFlowAction         String? // Action executada (se aplicável)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]       @relation("MessageReplies")
  reports      MessageReport[]

  @@index([conversationId, sentAt])
  @@index([senderId, senderType])
  @@index([status, sentAt])
  @@index([isDeleted])
  @@map("messages")
}

enum MessageContentType {
  TEXT // Texto simples
  IMAGE // Imagem
  VIDEO // Vídeo
  AUDIO // Áudio
  DOCUMENT // Documento (PDF, DOC, etc)
  LOCATION // Localização geográfica
  STICKER // Figurinha/Emoji
  SYSTEM // Mensagem do sistema
}

enum MessageStatus {
  QUEUED // Na fila para envio
  SENT // Enviada
  DELIVERED // Entregue
  READ // Lida
  FAILED // Falha no envio
}

// ============================================
// CANAIS OFICIAIS (BROADCAST)
// ============================================

model OfficialChannel {
  id              String @id @default(cuid())
  messageServerId String

  // Informações
  name        String // "Canal Oficial da Saúde"
  slug        String  @unique // "saude-oficial"
  description String? @db.Text
  iconUrl     String?
  bannerUrl   String?
  color       String? // Cor do canal (hex)

  // Vinculação
  departmentId String?
  managedBy    Json // Array de User IDs com permissão

  // Configurações
  isPublic         Boolean @default(true) // Qualquer um pode se inscrever?
  requiresApproval Boolean @default(false) // Inscrição precisa aprovação?
  isActive         Boolean @default(true)
  allowComments    Boolean @default(false) // Cidadãos podem comentar?

  // Estatísticas
  subscriberCount Int @default(0)
  messageCount    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  messageServer MessageServer         @relation(fields: [messageServerId], references: [id], onDelete: Cascade)
  subscriptions ChannelSubscription[]
  messages      ChannelMessage[]

  @@index([isActive, isPublic])
  @@index([slug])
  @@map("official_channels")
}

model ChannelSubscription {
  id        String @id @default(cuid())
  channelId String
  citizenId String

  // Status
  status       ChannelSubscriptionStatus @default(PENDING)
  subscribedAt DateTime                  @default(now())
  approvedAt   DateTime?
  approvedBy   String? // User ID que aprovou

  // Preferências de Notificação
  notifyInApp Boolean @default(true)
  notifyEmail Boolean @default(false)
  notifySMS   Boolean @default(false)
  notifyPush  Boolean @default(true)

  // Metadados
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  channel    OfficialChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveries ChannelDelivery[]

  @@unique([channelId, citizenId])
  @@index([citizenId, status])
  @@index([channelId, status])
  @@map("channel_subscriptions")
}

// SubscriptionStatus já definido no schema (usado por email)

model ChannelMessage {
  id        String @id @default(cuid())
  channelId String
  authorId  String // User ID (servidor público)

  // Conteúdo
  title       String?
  content     String             @db.Text
  contentType MessageContentType @default(TEXT)

  // Mídia
  attachments Json? // Array de {url, type, name, size}

  // Agendamento
  scheduledFor DateTime?
  publishedAt  DateTime?

  // Status
  status BroadcastStatus @default(DRAFT)

  // Estatísticas
  deliveredCount Int @default(0)
  readCount      Int @default(0)
  failedCount    Int @default(0)

  // Prioridade
  priority Int @default(3) // 1=urgent, 3=normal, 5=low

  // Metadados
  metadata Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  // Relacionamentos
  channel    OfficialChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveries ChannelDelivery[]

  @@index([channelId, publishedAt])
  @@index([status, scheduledFor])
  @@index([authorId])
  @@map("channel_messages")
}

enum BroadcastStatus {
  DRAFT // Rascunho
  SCHEDULED // Agendada
  SENDING // Enviando
  SENT // Enviada
  FAILED // Falhou
  CANCELLED // Cancelada
}

model ChannelDelivery {
  id             String @id @default(cuid())
  messageId      String
  subscriptionId String
  citizenId      String

  // Status
  status      MessageStatus @default(QUEUED)
  queuedAt    DateTime      @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  // Erro
  errorMessage String?
  retryCount   Int     @default(0)

  // Metadados
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  message      ChannelMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  subscription ChannelSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([messageId, citizenId])
  @@index([messageId, status])
  @@index([citizenId, status])
  @@index([status, queuedAt])
  @@map("channel_deliveries")
}

// ============================================
// PRIVACIDADE & MODERAÇÃO
// ============================================

model CitizenPrivacySettings {
  citizenId String @id

  // Quem pode enviar mensagens diretas?
  allowMessagesFromAll     Boolean @default(false) // Qualquer cidadão
  allowMessagesFromServers Boolean @default(true) // Servidores públicos

  // Bloqueios
  blockedCitizens Json @default("[]") // Array de citizen IDs
  blockedServers  Json @default("[]") // Array de user IDs

  // Notificações
  notifyNewMessage Boolean @default(true)
  notifySound      Boolean @default(true)
  notifyVibrate    Boolean @default(true)

  // Online Status
  showOnlineStatus Boolean @default(true)
  showLastSeen     Boolean @default(true)
  showReadReceipts Boolean @default(true)

  // Backup
  autoBackup Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("citizen_privacy_settings")
}

model MessageReport {
  id           String          @id @default(cuid())
  messageId    String
  reportedBy   String // Citizen ID ou User ID
  reporterType ParticipantType

  // Motivo
  reason      ReportReason
  description String?      @db.Text

  // Status
  status ReportStatus @default(PENDING)

  // Evidências
  screenshots Json? // Array de URLs de screenshots

  // Revisão
  reviewedAt  DateTime?
  reviewedBy  String? // User ID (moderador)
  reviewNotes String?           @db.Text
  action      ModerationAction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([reportedBy, reporterType])
  @@index([status, createdAt])
  @@map("message_reports")
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  INAPPROPRIATE_CONTENT
  SCAM
  IMPERSONATION
  VIOLENCE
  OTHER
}

enum ReportStatus {
  PENDING // Aguardando revisão
  REVIEWING // Em análise
  RESOLVED // Resolvida
  DISMISSED // Descartada
  ESCALATED // Escalada para autoridades
}

enum ModerationAction {
  NONE // Nenhuma ação
  WARNING // Aviso ao usuário
  MESSAGE_DELETED // Mensagem deletada
  USER_WARNED // Usuário advertido
  USER_SUSPENDED // Usuário suspenso temporariamente
  USER_BANNED // Usuário banido permanentemente
  REPORTED_POLICE // Reportado às autoridades
}

// ============================================
// LOGS & AUDITORIA
// ============================================

model MessageLog {
  id              String  @id @default(cuid())
  messageServerId String?

  // Tipo de evento
  level LogLevel @default(INFO)
  event String // message-sent, conversation-started, user-blocked, etc

  // Contexto
  userId         String?
  citizenId      String?
  conversationId String?
  messageId      String?
  channelId      String?

  // Dados
  message String @db.Text
  data    Json?

  // Request info
  ipAddress String?
  userAgent String?

  timestamp DateTime @default(now())

  // Relacionamentos
  messageServer MessageServer? @relation(fields: [messageServerId], references: [id], onDelete: SetNull)

  @@index([messageServerId, timestamp])
  @@index([event, timestamp])
  @@index([level, timestamp])
  @@index([userId])
  @@index([citizenId])
  @@map("message_logs")
}

// LogLevel já definido no schema (usado por outros módulos)

model MessageStats {
  id              String @id @default(cuid())
  messageServerId String

  // Data de referência
  date DateTime @db.Date
  hour Int? // 0-23 (null = agregado do dia)

  // Métricas de mensagens
  totalMessages   Int @default(0)
  textMessages    Int @default(0)
  mediaMessages   Int @default(0)
  deletedMessages Int @default(0)

  // Métricas de conversas
  totalConversations  Int @default(0)
  newConversations    Int @default(0)
  closedConversations Int @default(0)

  // Métricas de usuários
  activeUsers    Int @default(0) // Servidores ativos
  activeCitizens Int @default(0) // Cidadãos ativos
  onlineUsers    Int @default(0) // Online agora

  // Métricas de canais
  channelMessages      Int @default(0)
  channelSubscriptions Int @default(0)
  channelDeliveries    Int @default(0)

  // Performance
  avgResponseTime  Float? // Tempo médio de resposta (segundos)
  avgMessageLength Float? // Tamanho médio da mensagem

  // Moderação
  reportsCreated  Int @default(0)
  reportsResolved Int @default(0)
  usersBlocked    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  messageServer MessageServer @relation(fields: [messageServerId], references: [id], onDelete: Cascade)

  @@unique([messageServerId, date, hour])
  @@index([messageServerId, date])
  @@map("message_stats")
}

// ============================================
// SESSÕES WEBSOCKET (TRACKING)
// ============================================

model WebSocketSession {
  id       String @id @default(cuid())
  socketId String @unique // Socket.io socket.id

  // Usuário
  userId   String?
  userType ParticipantType

  // Conexão
  ipAddress   String
  userAgent   String?
  connectedAt DateTime @default(now())
  lastPingAt  DateTime @default(now())

  // Status
  isOnline Boolean @default(true)

  // Metadados
  metadata Json?

  disconnectedAt DateTime?

  @@index([userId, userType, isOnline])
  @@index([connectedAt])
  @@map("websocket_sessions")
}

// ============================================
// TEMPLATES DE MENSAGENS AUTOMÁTICAS
// ============================================

model MessageTemplate {
  id String @id @default(cuid())

  // Identificação
  name     String           @unique // protocol-created, welcome-message, etc
  category TemplateCategory

  // Conteúdo
  title       String?
  content     String             @db.Text
  contentType MessageContentType @default(TEXT)

  // Variáveis
  variables Json @default("[]") // ["citizenName", "protocolNumber", etc]

  // Configuração
  isActive Boolean @default(true)
  isSystem Boolean @default(false) // Template do sistema (não editável)

  // Metadados
  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

enum TemplateCategory {
  WELCOME // Boas-vindas
  PROTOCOL // Relacionado a protocolos
  NOTIFICATION // Notificações gerais
  REMINDER // Lembretes
  CONFIRMATION // Confirmações
  ALERT // Alertas
  SYSTEM // Sistema
}

enum ChannelSubscriptionStatus {
  PENDING // Aguardando aprovação
  ACTIVE // Inscrito e recebendo
  MUTED // Inscrito mas sem notificações
  BLOCKED // Bloqueado de se inscrever
}

// ============================================================================
// SISTEMA DE GERAÇÃO DE DOCUMENTOS
// ============================================================================

model DocumentTemplate {
  id String @id @default(cuid())

  // Identificação
  name        String // Ex: "Certidão de Protocolo"
  code        String  @unique // Ex: "CERTIDAO_PROTOCOLO"
  description String?

  // Tipo de documento
  documentType DocumentTemplateType // PROTOCOL_CERTIFICATE, COMPLETION_REPORT, etc
  outputFormat OutputFormat // PDF, DOCX, HTML

  // Associação com serviços
  serviceIds Json    @default("[]") // Array de IDs de serviços
  isGlobal   Boolean @default(false) // Se true, disponível para todos os serviços

  // ✅ NOVO: Controle de quando o template pode ser usado no workflow
  allowedStageTypes Json? @default("[]") // Array de stageTypes permitidos (ex: ["CONCLUSION", "APPROVAL"])

  // Template Handlebars
  htmlTemplate String  @db.Text // HTML com variáveis {{protocolNumber}}, {{citizenName}}
  headerHtml   String? @db.Text // Cabeçalho (logo, brasão)
  footerHtml   String? @db.Text // Rodapé (assinaturas, carimbos)
  cssStyles    String? @db.Text // CSS para estilização

  // Variáveis disponíveis (documentação)
  availableVariables Json? @default("[]") // Array de {name, description, example}

  // Configurações de geração
  pageSize    String @default("A4") // A4, Letter, Legal
  orientation String @default("portrait") // portrait, landscape
  margins     Json? // {top, right, bottom, left} em mm

  // Assinaturas/Carimbos
  requiresSignature Boolean @default(false)
  signatureFields   Json?   @default("[]") // Array de {label, role, position}

  // Controle
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relacionamentos
  generatedDocuments GeneratedDocument[]

  @@index([isActive])
  @@index([documentType])
  @@map("document_templates")
}

enum DocumentTemplateType {
  PROTOCOL_CERTIFICATE // Certidão/comprovante de protocolo
  COMPLETION_REPORT // Relatório de conclusão
  RECEIPT // Recibo de atendimento
  AUTHORIZATION // Autorização/licença
  NOTIFICATION // Notificação
  CUSTOM // Personalizado
}

enum OutputFormat {
  PDF
  DOCX
  HTML
}

model GeneratedDocument {
  id String @id @default(cuid())

  // Referências
  protocolId String
  templateId String

  // Arquivo gerado
  fileName String
  filePath String // /uploads/generated/{protocolId}/{timestamp}_{fileName}
  fileUrl  String? // URL pública (se configurado)
  fileSize Int
  mimeType String

  // Metadados
  generatedAt     DateTime @default(now())
  generatedBy     String // userId do admin
  templateVersion Int // Versão do template usada

  // Dados usados na geração (snapshot)
  variablesUsed Json // Snapshot dos dados usados {protocolNumber, citizenName, etc}

  // Envio
  wasSent Boolean   @default(false)
  sentAt  DateTime?
  sentBy  String?
  sentTo  String? // Email do destinatário

  // Assinatura Digital
  isSigned Boolean @default(false) // Se o documento foi assinado digitalmente

  // Controle
  isActive  Boolean   @default(true) // Soft delete
  deletedAt DateTime?

  // SISTEMA DE VALIDAÇÃO DE DOCUMENTOS
  validationCode  String?   @unique // Código único de validação (VAL-YYYY-XXXXXX-CCCC)
  documentHash    String? // Hash SHA-256 do documento para verificação de integridade
  expiresAt       DateTime? // Data de expiração (opcional)
  validatedCount  Int       @default(0) // Contador de validações públicas
  lastValidatedAt DateTime? // Última validação pública

  // Relacionamentos
  protocol   ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  template   DocumentTemplate   @relation(fields: [templateId], references: [id])
  signatures Signature[]

  @@index([protocolId])
  @@index([templateId])
  @@index([generatedAt])
  @@index([validationCode])
  @@index([documentHash])
  @@map("generated_documents")
}

// ========================================
// CATEGORIZAÇÃO DE CIDADÃOS
// ========================================

model CitizenCategory {
  id          String  @id @default(cuid())
  code        String  @unique // Ex: PRODUTOR_RURAL, ARTISTA_LOCAL
  name        String // Ex: "Produtor Rural", "Artista Local"
  description String? @db.Text
  department  String // Departamento responsável
  icon        String? // Ícone visual
  color       String? // Cor para UI
  active      Boolean @default(true)

  // ═══════════════════════════════════════════════════════════════════
  // ✅ SISTEMA SIMPLES DE AUTO-ATRIBUIÇÃO
  // ═══════════════════════════════════════════════════════════════════
  // Array de moduleTypes que ativam esta categoria quando protocolo aprovado
  // Ex: ["CADASTRO_PRODUTOR", "RENOVACAO_PRODUTOR"]
  triggerServices String[] @default([])

  // ═══════════════════════════════════════════════════════════════════
  // RELACIONAMENTOS ENTRE CATEGORIAS
  // ═══════════════════════════════════════════════════════════════════
  parentCategoryId String?
  parentCategory   CitizenCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories  CitizenCategory[] @relation("CategoryHierarchy")

  level                   Int      @default(1) // Nível hierárquico (1=base, 2=intermediário, 3=avançado)
  prerequisiteCategories  String[] @default([]) // Códigos de categorias pré-requisito
  complementaryCategories String[] @default([]) // Códigos de categorias complementares
  conflictingCategories   String[] @default([]) // Códigos de categorias conflitantes

  // ═══════════════════════════════════════════════════════════════════
  // VALIDADE E RENOVAÇÃO
  // ═══════════════════════════════════════════════════════════════════
  hasValidity            Boolean @default(false)
  validityDays           Int? // Dias de validade após atribuição
  requiresRenewal        Boolean @default(false)
  renewalReminderDays    Int     @default(30) // Dias antes do vencimento para enviar lembrete
  autoDeactivateOnExpiry Boolean @default(false)

  // ═══════════════════════════════════════════════════════════════════
  // PROGRESSÃO E GAMIFICAÇÃO
  // ═══════════════════════════════════════════════════════════════════
  hasProgression      Boolean @default(false)
  nextLevelCategory   String? // Código da próxima categoria na progressão
  progressionCriteria Json? // Critérios para evoluir (protocolos, tempo, etc)

  // ═══════════════════════════════════════════════════════════════════
  // METADATA AVANÇADA
  // ═══════════════════════════════════════════════════════════════════
  categoryType     String  @default("STANDARD") // STANDARD, PREMIUM, TEMPORARY, SYSTEM
  priority         Int     @default(5) // 1=alta, 10=baixa
  isPublic         Boolean @default(true) // Se aparece no perfil público
  requiresApproval Boolean @default(false) // Se requer aprovação manual
  benefits         Json? // Benefícios da categoria
  restrictions     Json? // Restrições/requisitos

  // Relacionamentos
  citizens              CitizenCategoryAssignment[]
  relationshipsAsSource CitizenCategoryRelationship[] @relation("SourceCategory")
  relationshipsAsTarget CitizenCategoryRelationship[] @relation("TargetCategory")
  badges                CitizenCategoryBadge[]

  createdAt                        DateTime                         @default(now())
  updatedAt                        DateTime                         @updatedAt
  citizenCategoryProtocolHistories CitizenCategoryProtocolHistory[]
  citizenCategoryAuditLogs         CitizenCategoryAuditLog[]

  @@index([code])
  @@index([active])
  @@index([parentCategoryId])
  @@index([level])
  @@index([categoryType])
  @@index([hasValidity])
  @@index([hasProgression])
  @@map("citizen_categories")
}

model CitizenCategoryAssignment {
  id String @id @default(cuid())

  citizenId String
  citizen   Citizen @relation("CitizenCategories", fields: [citizenId], references: [id], onDelete: Cascade)

  categoryId String
  category   CitizenCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Rastreabilidade - protocolo que originou a categoria (MANTIDO POR COMPATIBILIDADE)
  protocolId String?
  protocol   ProtocolSimplified? @relation("ProtocolGeneratedCategories", fields: [protocolId], references: [id], onDelete: SetNull)

  assignedAt     DateTime @default(now())
  assignedBy     String? // Usuário que atribuiu (se manual)
  assignedByUser User?    @relation("CategoryAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  active             Boolean   @default(true)
  deactivatedAt      DateTime?
  deactivatedBy      String?
  deactivationReason String?

  // ═══════════════════════════════════════════════════════════════════
  // VALIDADE E RENOVAÇÃO
  // ═══════════════════════════════════════════════════════════════════
  validFrom       DateTime? // Data de início da validade
  validUntil      DateTime? // Data final da validade
  expiresAt       DateTime? // Data de expiração (calculada)
  isExpired       Boolean   @default(false)
  lastRenewalDate DateTime? // Data da última renovação
  renewalCount    Int       @default(0) // Quantas vezes foi renovada

  // ═══════════════════════════════════════════════════════════════════
  // PROGRESSÃO E GAMIFICAÇÃO
  // ═══════════════════════════════════════════════════════════════════
  level            Int  @default(1) // Nível atual dentro da categoria
  experiencePoints Int  @default(0) // Pontos de experiência acumulados
  badges           Json @default("[]") // Array de badges conquistados
  achievements     Json @default("[]") // Conquistas específicas

  // ═══════════════════════════════════════════════════════════════════
  // ESTATÍSTICAS E HISTÓRICO
  // ═══════════════════════════════════════════════════════════════════
  protocolCount    Int       @default(0) // Quantidade de protocolos relacionados
  lastProtocolDate DateTime? // Data do último protocolo
  statistics       Json      @default("{}") // Estatísticas diversas

  // ═══════════════════════════════════════════════════════════════════
  // AUDITORIA EXPANDIDA
  // ═══════════════════════════════════════════════════════════════════
  activationCount   Int     @default(1) // Quantas vezes foi ativada
  deactivationCount Int     @default(0) // Quantas vezes foi desativada
  notes             String? // Notas administrativas

  // Dados específicos desta atribuição (ex: número DAP, especialidade artística)
  metadata Json?

  // Relacionamentos
  protocolHistory CitizenCategoryProtocolHistory[]
  auditLog        CitizenCategoryAuditLog[]

  @@unique([citizenId, categoryId])
  @@index([citizenId])
  @@index([categoryId])
  @@index([protocolId])
  @@index([active])
  @@index([expiresAt])
  @@index([isExpired])
  @@index([level])
  @@index([lastProtocolDate])
  @@map("citizen_category_assignments")
}

// ============================================================================
// HISTÓRICO DE PROTOCOLOS POR CATEGORIA
// ============================================================================
model CitizenCategoryProtocolHistory {
  id String @id @default(cuid())

  // Relacionamentos
  assignmentId String
  assignment   CitizenCategoryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  protocolId String
  protocol   ProtocolSimplified @relation("CategoryProtocolHistory", fields: [protocolId], references: [id], onDelete: Cascade)

  citizenId String
  citizen   Citizen @relation("CitizenCategoryProtocolHistory", fields: [citizenId], references: [id], onDelete: Cascade)

  categoryId String
  category   CitizenCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Dados do evento
  eventType String // 'ASSIGNED', 'RENEWED', 'UPGRADED', 'REACTIVATED'
  eventDate DateTime @default(now())

  // Dados do protocolo
  protocolNumber String?
  moduleType     String?
  serviceName    String?

  // Metadata do evento
  metadata Json?

  createdAt DateTime @default(now())

  @@index([assignmentId])
  @@index([protocolId])
  @@index([citizenId])
  @@index([categoryId])
  @@index([eventType])
  @@index([eventDate])
  @@map("citizen_category_protocol_history")
}

// ============================================================================
// LOG DE AUDITORIA DE CATEGORIAS
// ============================================================================
model CitizenCategoryAuditLog {
  id String @id @default(cuid())

  // Relacionamentos
  assignmentId String
  assignment   CitizenCategoryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  citizenId String
  citizen   Citizen @relation("CitizenCategoryAuditLog", fields: [citizenId], references: [id], onDelete: Cascade)

  categoryId String
  category   CitizenCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Tipo de ação
  action     String // 'ASSIGNED', 'ACTIVATED', 'DEACTIVATED', 'RENEWED', 'UPGRADED', 'EXPIRED'
  actionDate DateTime @default(now())

