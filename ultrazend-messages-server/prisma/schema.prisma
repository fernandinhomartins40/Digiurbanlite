// ✅ FASE 1.1: CONSULTA MÉDICA COM MÉTODO SOAP
model ConsultaMedica {
  id                  String            @id @default(cuid())
  atendimentoId       String            @unique
  atendimento         AtendimentoMedico @relation(fields: [atendimentoId], references: [id])
  medicoId            String
  profissionalSaudeId String?

  // ========================================
  // S - SUBJETIVO (Informações do Paciente)
  // ========================================
  motivoConsulta    String? @db.Text // Queixa principal
  historiaAtual     String? @db.Text // História da doença atual (HDA)
  historiaPregressa String? @db.Text // Antecedentes pessoais
  historiaFamiliar  String? @db.Text // Antecedentes familiares
  historiaSocial    String? @db.Text // Hábitos, ocupação, condições sociais

  // ========================================
  // O - OBJETIVO (Exame Físico e Sinais)
  // ========================================
  sinaisVitais        Json? // { pressaoArterial, temperatura, fc, fr, saturacaoO2 }
  exameFisicoGeral    String? @db.Text // Inspeção geral, estado geral
  exameFisicoSistemas Json? // { cardiovascular, respiratorio, abdomen, neurologico, etc }
  antropometria       Json? // { peso, altura, imc, circunferencias }

  // ========================================
  // A - AVALIAÇÃO (Diagnóstico)
  // ========================================
  hipoteseDiagnostica  String?            @db.Text // Raciocínio clínico
  diagnosticoPrincipal String? // CID10 ou CIAP2 principal
  diagnosticosSecund   Json? // Array de CIDs/CIAPs secundários
  problemas            ProblemaCondicao[] // Lista de problemas identificados

  // ========================================
  // P - PLANO (Conduta e Tratamento)
  // ========================================
  condutaTerapeutica String?           @db.Text // Tratamento proposto
  orientacoes        String?           @db.Text // Orientações ao paciente
  prescricoes        Prescricao[]
  examesSolicitados  ExameSolicitado[]
  encaminhamentos    Encaminhamento[]
  atestados          Atestado[]

  // Retorno
  retornoNecessario Boolean   @default(false)
  prazoRetornoDias  Int?
  dataRetorno       DateTime?

  // Observações gerais
  observacoes String?  @db.Text
  dataHora    DateTime @default(now())

  // Relacionamento com Pré-Natal (se for consulta obstétrica)
  consultaPreNatal ConsultaPreNatal?

  @@map("consultas_medicas")
}

// ✅ FASE 1.2: LISTA DE PROBLEMAS E CONDIÇÕES (CIAP2/CID10)
model ProblemaCondicao {
  id        String @id @default(cuid())
