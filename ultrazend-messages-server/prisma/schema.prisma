generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MessageServer {
  id               String            @id @default(cuid())
  name             String
  hostname         String
  wsPort           Int               @default(9001)
  isActive         Boolean           @default(false)
  maxDailyMessages Int               @default(100000)
  enableEncryption Boolean           @default(false)
  enableP2P        Boolean           @default(false)
  enableBroadcast  Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  conversations    Conversation[]
  logs             MessageLog[]
  stats            MessageStats[]
  channels         OfficialChannel[]

  @@map("message_servers")
}

model Conversation {
  id                 String             @id @default(cuid())
  messageServerId    String
  participant1Id     String
  participant1Type   ParticipantType
  participant2Id     String
  participant2Type   ParticipantType
  protocolId         String?
  departmentId       String?
  type               ConversationType   @default(SUPPORT)
  status             ConversationStatus @default(ACTIVE)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  totalMessages      Int                @default(0)
  unreadCount1       Int                @default(0)
  unreadCount2       Int                @default(0)
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  closedAt           DateTime?
  messageServer      MessageServer      @relation(fields: [messageServerId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@unique([participant1Id, participant1Type, participant2Id, participant2Type, protocolId])
  @@index([participant1Id, participant1Type, status])
  @@index([participant2Id, participant2Type, status])
  @@index([protocolId])
  @@index([status, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String             @id @default(cuid())
  conversationId String
  senderId       String
  senderType     ParticipantType
  content        String
  contentType    MessageContentType @default(TEXT)
  attachments    Json?
  replyToId      String?
  status         MessageStatus      @default(SENT)
  sentAt         DateTime           @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  isEdited       Boolean            @default(false)
  editedAt       DateTime?
  isDeleted      Boolean            @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  reports        MessageReport[]
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?           @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]          @relation("MessageReplies")

  @@index([conversationId, sentAt])
  @@index([senderId, senderType])
  @@index([status, sentAt])
  @@index([isDeleted])
  @@map("messages")
}

model OfficialChannel {
  id               String                @id @default(cuid())
  messageServerId  String
  name             String
  slug             String                @unique
  description      String?
  iconUrl          String?
  bannerUrl        String?
  color            String?
  departmentId     String?
  managedBy        Json
  isPublic         Boolean               @default(true)
  requiresApproval Boolean               @default(false)
  isActive         Boolean               @default(true)
  allowComments    Boolean               @default(false)
  subscriberCount  Int                   @default(0)
  messageCount     Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  messages         ChannelMessage[]
  subscriptions    ChannelSubscription[]
  messageServer    MessageServer         @relation(fields: [messageServerId], references: [id], onDelete: Cascade)

  @@index([isActive, isPublic])
  @@index([slug])
  @@map("official_channels")
}

model ChannelSubscription {
  id           String                    @id @default(cuid())
  channelId    String
  citizenId    String
  status       ChannelSubscriptionStatus @default(PENDING)
  subscribedAt DateTime                  @default(now())
  approvedAt   DateTime?
  approvedBy   String?
  notifyInApp  Boolean                   @default(true)
  notifyEmail  Boolean                   @default(false)
  notifySMS    Boolean                   @default(false)
  notifyPush   Boolean                   @default(true)
  metadata     Json?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  deliveries   ChannelDelivery[]
  channel      OfficialChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, citizenId])
  @@index([citizenId, status])
  @@index([channelId, status])
  @@map("channel_subscriptions")
}

model ChannelMessage {
  id             String             @id @default(cuid())
  channelId      String
  authorId       String
  title          String?
  content        String
  contentType    MessageContentType @default(TEXT)
  attachments    Json?
  scheduledFor   DateTime?
  publishedAt    DateTime?
  status         BroadcastStatus    @default(DRAFT)
  deliveredCount Int                @default(0)
  readCount      Int                @default(0)
  failedCount    Int                @default(0)
  priority       Int                @default(3)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sentAt         DateTime?
  deliveries     ChannelDelivery[]
  channel        OfficialChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, publishedAt])
  @@index([status, scheduledFor])
  @@index([authorId])
  @@map("channel_messages")
}

model ChannelDelivery {
  id             String              @id @default(cuid())
  messageId      String
  subscriptionId String
  citizenId      String
  status         MessageStatus       @default(QUEUED)
  queuedAt       DateTime            @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  errorMessage   String?
  retryCount     Int                 @default(0)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  message        ChannelMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  subscription   ChannelSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([messageId, citizenId])
  @@index([messageId, status])
  @@index([citizenId, status])
  @@index([status, queuedAt])
  @@map("channel_deliveries")
}

model CitizenPrivacySettings {
  citizenId                String   @id
  allowMessagesFromAll     Boolean  @default(false)
  allowMessagesFromServers Boolean  @default(true)
  blockedCitizens          Json     @default("[]")
  blockedServers           Json     @default("[]")
  notifyNewMessage         Boolean  @default(true)
  notifySound              Boolean  @default(true)
  notifyVibrate            Boolean  @default(true)
  showOnlineStatus         Boolean  @default(true)
  showLastSeen             Boolean  @default(true)
  showReadReceipts         Boolean  @default(true)
  autoBackup               Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("citizen_privacy_settings")
}

model MessageReport {
  id           String            @id @default(cuid())
  messageId    String
  reportedBy   String
  reporterType ParticipantType
  reason       ReportReason
  description  String?
  status       ReportStatus      @default(PENDING)
  screenshots  Json?
  reviewedAt   DateTime?
  reviewedBy   String?
  reviewNotes  String?
  action       ModerationAction?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  message      Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([reportedBy, reporterType])
  @@index([status, createdAt])
  @@map("message_reports")
}

model MessageLog {
  id              String         @id @default(cuid())
  messageServerId String?
  level           LogLevel       @default(INFO)
  event           String
  userId          String?
  citizenId       String?
  conversationId  String?
  messageId       String?
  channelId       String?
  message         String
  data            Json?
  ipAddress       String?
  userAgent       String?
  timestamp       DateTime       @default(now())
  messageServer   MessageServer? @relation(fields: [messageServerId], references: [id])

  @@index([messageServerId, timestamp])
  @@index([event, timestamp])
  @@index([level, timestamp])
  @@index([userId])
  @@index([citizenId])
  @@map("message_logs")
}

model MessageStats {
  id                   String        @id @default(cuid())
  messageServerId      String
  date                 DateTime      @db.Date
  hour                 Int?
  totalMessages        Int           @default(0)
  textMessages         Int           @default(0)
  mediaMessages        Int           @default(0)
  deletedMessages      Int           @default(0)
  totalConversations   Int           @default(0)
  newConversations     Int           @default(0)
  closedConversations  Int           @default(0)
  activeUsers          Int           @default(0)
  activeCitizens       Int           @default(0)
  onlineUsers          Int           @default(0)
  channelMessages      Int           @default(0)
  channelSubscriptions Int           @default(0)
  channelDeliveries    Int           @default(0)
  avgResponseTime      Float?
  avgMessageLength     Float?
  reportsCreated       Int           @default(0)
  reportsResolved      Int           @default(0)
  usersBlocked         Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  messageServer        MessageServer @relation(fields: [messageServerId], references: [id], onDelete: Cascade)

  @@unique([messageServerId, date, hour])
  @@index([messageServerId, date])
  @@map("message_stats")
}

model WebSocketSession {
  id             String          @id @default(cuid())
  socketId       String          @unique
  userId         String?
  userType       ParticipantType
  ipAddress      String
  userAgent      String?
  connectedAt    DateTime        @default(now())
  lastPingAt     DateTime        @default(now())
  isOnline       Boolean         @default(true)
  metadata       Json?
  disconnectedAt DateTime?

  @@index([userId, userType, isOnline])
  @@index([connectedAt])
  @@map("websocket_sessions")
}

model MessageTemplate {
  id          String             @id @default(cuid())
  name        String             @unique
  category    TemplateCategory
  title       String?
  content     String
  contentType MessageContentType @default(TEXT)
  variables   Json               @default("[]")
  isActive    Boolean            @default(true)
  isSystem    Boolean            @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("message_templates")
}

model Citizen {
  id                                                         String                         @id @default(cuid())
  cpf                                                        String                         @unique
  name                                                       String
  email                                                      String
  phone                                                      String?
  birthDate                                                  DateTime?
  address                                                    Json?
  municipioId                                                String?
  isActive                                                   Boolean                        @default(true)
  password                                                   String
  failedLoginAttempts                                        Int                            @default(0)
  lockedUntil                                                DateTime?
  verificationStatus                                         VerificationStatus             @default(PENDING)
  verifiedAt                                                 DateTime?
  verifiedBy                                                 String?
  verificationNotes                                          String?
  registrationSource                                         String                         @default("SELF")
  createdAt                                                  DateTime                       @default(now())
  updatedAt                                                  DateTime                       @updatedAt
  lastLogin                                                  DateTime?
  rg                                                         String?
  phoneSecondary                                             String?
  motherName                                                 String?
  maritalStatus                                              String?
  occupation                                                 String?
  familyIncome                                               String?
  avatar                                                     String?
  admin_tickets                                              admin_tickets[]
  audit_logs                                                 audit_logs[]
  bot_conversations                                          bot_conversations[]
  bot_uploads                                                bot_uploads[]
  citizen_category_assignments                               citizen_category_assignments[]
  citizen_documents                                          citizen_documents[]
  citizen_transfer_requests                                  citizen_transfer_requests[]
  family_compositions_family_compositions_headIdTocitizens   family_compositions[]          @relation("family_compositions_headIdTocitizens")
  family_compositions_family_compositions_memberIdTocitizens family_compositions[]          @relation("family_compositions_memberIdTocitizens")
  notifications                                              notifications[]
  password_reset_tokens                                      password_reset_tokens[]
  proactive_notifications                                    proactive_notifications[]
  protocol_citizen_links                                     protocol_citizen_links[]
  protocols_simplified                                       protocols_simplified[]

  @@map("citizens")
}

model User {
  id                                                              String                         @id @default(cuid())
  email                                                           String                         @unique
  name                                                            String
  password                                                        String
  role                                                            UserRole                       @default(USER)
  isActive                                                        Boolean                        @default(true)
  departmentId                                                    String?
  failedLoginAttempts                                             Int                            @default(0)
  lockedUntil                                                     DateTime?
  mustChangePassword                                              Boolean                        @default(false)
  createdAt                                                       DateTime                       @default(now())
  updatedAt                                                       DateTime                       @updatedAt
  lastLogin                                                       DateTime?
  admin_tickets_admin_tickets_assignedUserIdTousers               admin_tickets[]                @relation("admin_tickets_assignedUserIdTousers")
  admin_tickets_admin_tickets_requestedByIdTousers                admin_tickets[]                @relation("admin_tickets_requestedByIdTousers")
  agenda_events                                                   agenda_events[]
  audit_logs                                                      audit_logs[]
  certificate_revocation_list                                     certificate_revocation_list[]
  citizen_category_assignments                                    citizen_category_assignments[]
  citizen_transfer_requests                                       citizen_transfer_requests[]
  digital_certificates                                            digital_certificates[]
  email_drafts                                                    email_drafts[]
  field_approvals                                                 field_approvals[]
  field_changes                                                   field_changes[]
  password_reset_tokens                                           password_reset_tokens[]
  protocols_simplified_protocols_simplified_assignedUserIdTousers protocols_simplified[]         @relation("protocols_simplified_assignedUserIdTousers")
  protocols_simplified_protocols_simplified_createdByIdTousers    protocols_simplified[]         @relation("protocols_simplified_createdByIdTousers")
  user_departments                                                user_departments[]
  department                                                      Department?                    @relation(fields: [departmentId], references: [id])

  @@map("users")
}

model Department {
  id                   String                 @id @default(cuid())
  name                 String                 @unique
  code                 String?                @unique
  description          String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  admin_tickets        admin_tickets[]
  protocols_simplified protocols_simplified[]
  services_simplified  services_simplified[]
  user_departments     user_departments[]
  users                User[]

  @@map("departments")
}

model acompanhamentos_beneficio {
  id                           String                       @id
  inscricaoId                  String
  tipo                         TipoAcompanhamento
  assistenteSocialId           String?
  responsavelId                String
  data                         DateTime                     @default(now())
  dataVisita                   DateTime?
  descricao                    String
  observacoes                  String?
  proximoAcompanhamento        DateTime?
  inscricoes_programas_sociais inscricoes_programas_sociais @relation(fields: [inscricaoId], references: [id])

  @@index([inscricaoId])
}

model admin_tickets {
  id                                        String                @id
  number                                    String                @unique
  title                                     String
  description                               String
  priority                                  Int                   @default(3)
  requestedById                             String
  citizenId                                 String
  serviceId                                 String
  departmentId                              String
  status                                    TicketStatus          @default(PENDING)
  protocolId                                String?               @unique
  assignedUserId                            String?
  createdAt                                 DateTime              @default(now())
  updatedAt                                 DateTime
  acceptedAt                                DateTime?
  rejectedAt                                DateTime?
  protocolCreatedAt                         DateTime?
  observations                              String?
  rejectionReason                           String?
  acceptedBy                                String?
  rejectedBy                                String?
  users_admin_tickets_assignedUserIdTousers User?                 @relation("admin_tickets_assignedUserIdTousers", fields: [assignedUserId], references: [id])
  citizens                                  Citizen               @relation(fields: [citizenId], references: [id])
  departments                               Department            @relation(fields: [departmentId], references: [id])
  protocols_simplified                      protocols_simplified? @relation(fields: [protocolId], references: [id])
  users_admin_tickets_requestedByIdTousers  User                  @relation("admin_tickets_requestedByIdTousers", fields: [requestedById], references: [id])
  services_simplified                       services_simplified   @relation(fields: [serviceId], references: [id])

  @@index([createdAt])
  @@index([departmentId, status])
  @@index([requestedById])
  @@index([status])
}

model agenda_events {
  id             String   @id
  tipo           String
  titulo         String
  descricao      String?
  dataHoraInicio DateTime
  dataHoraFim    DateTime
  local          String?
  participantes  String?
  status         String   @default("AGENDADO")
  observacoes    String?
  anexos         String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  users          User     @relation(fields: [createdById], references: [id])

  @@index([dataHoraInicio])
  @@index([status])
}

model agendas_medicas {
  id                  String                @id
  profissionalId      String
  unidadeId           String
  diaSemana           Int
  horaInicio          String
  horaFim             String
  tempoPorConsulta    Int
  vagasDisponiveis    Int
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  consultas_agendadas consultas_agendadas[]

  @@index([profissionalId, diaSemana])
  @@index([unidadeId, isActive])
}

model alert_triggers {
  id          String    @id
  alertId     String
  value       Float
  message     String
  data        Json?
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  triggeredAt DateTime  @default(now())
  alerts      alerts    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, triggeredAt])
  @@index([isResolved, triggeredAt])
}

model alerts {
  id             String           @id
  name           String
  description    String?
  type           AlertType
  metric         String
  condition      String
  threshold      Float
  threshold2     Float?
  frequency      AlertFrequency
  isActive       Boolean          @default(true)
  cooldown       Int              @default(3600)
  recipients     Json?
  channels       Json?
  lastTriggered  DateTime?
  triggerCount   Int              @default(0)
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  alert_triggers alert_triggers[]

  @@index([metric, isActive])
  @@index([type, isActive])
}

model alunos_rotas {
  id            String   @id
  alunoId       String
  rotaId        String
  pontoEmbarque String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@unique([alunoId, rotaId])
}

model analytics {
  id         String   @id
  type       String
  entityId   String
  metric     String
  value      Float
  dimension  String?
  period     String
  periodType String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([entityId, metric])
  @@index([periodType, createdAt])
  @@index([type, metric, period])
}

model atendimentos_medicos {
  id                 String              @id
  workflowId         String              @unique
  protocolId         String?             @unique
  consultaAgendadaId String?             @unique
  citizenId          String
  unidadeId          String
  dataAtendimento    DateTime            @default(now())
  tipo               TipoAtendimento
  status             AtendimentoStatus
  prioridade         Int                 @default(0)
  recepcaoId         String?
  horarioCheckin     DateTime?
  triagemId          String?
  horarioTriagem     DateTime?
  consultaId         String?
  profissionalId     String?
  horarioConsulta    DateTime?
  farmaciaId         String?
  horarioFarmacia    DateTime?
  tempoTotalMinutos  Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  consultas_medicas  consultas_medicas?
  triagem_enfermagem triagem_enfermagem?

  @@index([citizenId])
  @@index([status])
  @@index([unidadeId, dataAtendimento])
  @@index([workflowId])
}

model atestados {
  id                String            @id
  consultaId        String
  tipo              TipoAtestado
  cid10             String?
  diasAfastamento   Int
  dataInicio        DateTime
  dataFim           DateTime
  observacoes       String?
  dataHora          DateTime          @default(now())
  consultas_medicas consultas_medicas @relation(fields: [consultaId], references: [id])

  @@index([consultaId])
}

model audit_logs {
  id           String   @id
  userId       String?
  citizenId    String?
  action       String
  resource     String?
  method       String?
  details      Json?
  ip           String?
  userAgent    String?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
  citizens     Citizen? @relation(fields: [citizenId], references: [id])
  users        User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([citizenId])
  @@index([createdAt])
  @@index([userId])
}

model benchmarks {
  id         String   @id
  metric     String
  category   String
  region     String
  population String
  p25        Float?
  p50        Float?
  p75        Float?
  average    Float?
  sampleSize Int
  period     String
  year       Int
  source     String?
  updatedAt  DateTime

  @@index([category, year])
  @@index([metric, region, population])
}

model bot_analytics {
  id              String   @id
  date            DateTime @default(now()) @db.Date
  intent          String
  totalCount      Int      @default(0)
  successCount    Int      @default(0)
  transferCount   Int      @default(0)
  avgConfidence   Float?
  avgResponseTime Float?
  uniqueCitizens  Int      @default(0)

  @@unique([date, intent])
  @@index([date])
  @@index([intent])
}

model bot_conversations {
  id            String         @id
  citizenId     String
  intent        String?
  confidence    Float?
  currentFlow   String?
  flowStep      Int            @default(0)
  flowData      Json?
  isActive      Boolean        @default(true)
  closedAt      DateTime?
  rating        Int?
  ratingComment String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  citizens      Citizen        @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  bot_messages  bot_messages[]

  @@index([citizenId])
  @@index([createdAt])
  @@index([currentFlow])
  @@index([isActive])
}

model bot_messages {
  id                String            @id
  conversationId    String
  role              String
  content           String
  messageType       String            @default("text")
  metadata          Json?
  intent            String?
  confidence        Float?
  wasTransferred    Boolean           @default(false)
  createdAt         DateTime          @default(now())
  bot_conversations bot_conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([intent])
  @@index([role])
}

model bot_uploads {
  id             String    @id
  citizenId      String
  conversationId String?
  fileName       String
  fileSize       Int
  mimeType       String
  fileUrl        String
  uploadedAt     DateTime  @default(now())
  expiresAt      DateTime?
  citizens       Citizen   @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId])
  @@index([conversationId])
  @@index([uploadedAt])
}

model cache_entries {
  id        String   @id
  key       String   @unique
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([expiresAt])
}

model cadunico_familias {
  id                    String            @id
  workflowId            String            @unique
  responsavelFamiliarId String
  nisResponsavel        String?           @unique
  crasId                String?
  dataAgendamento       DateTime?
  horarioAgendamento    String?
  agendadoPor           String?
  entrevistadoPor       String?
  entrevistadorId       String?
  dataEntrevista        DateTime?
  localEntrevista       String?
  rendaTotalFamiliar    Float             @default(0)
  rendaPerCapita        Float             @default(0)
  fontesRenda           Json?
  despesaMoradia        Float?
  despesaAlimentacao    Float?
  despesaSaude          Float?
  despesaEducacao       Float?
  despesaOutros         Float?
  tipoMoradia           TipoMoradia
  situacaoMoradia       SituacaoMoradia
  aguaEncanada          Boolean           @default(false)
  energiaEletrica       Boolean           @default(false)
  esgoto                Boolean           @default(false)
  coletaLixo            Boolean           @default(false)
  endereco              Json?
  documentos            Json
  validadoPor           String?
  dataValidacao         DateTime?
  analisadoPor          String?
  dataAnalise           DateTime?
  parecerSocial         String?
  motivoIndeferimento   String?
  nisFamilia            String?           @unique
  numeroCadUnico        String?           @unique
  dataCadastro          DateTime?
  dataUltimaAtualizacao DateTime?
  proximaAtualizacao    DateTime?
  status                CadUnicoStatus
