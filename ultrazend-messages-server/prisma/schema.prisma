  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamento
  service ServiceSimplified @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("service_workflows")
}

// ============================================================================
// WORKFLOWS LEGADO - MANTIDO PARA COMPATIBILIDADE TEMPORÁRIA
