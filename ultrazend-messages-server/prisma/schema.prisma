// UltraZend Messages Server - Prisma Schema
// ALIGNED WITH DigiUrban Backend Schema
// Uses the same database and tables as DigiUrban

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MESSAGE MODELS (from DigiUrban Backend)
// ============================================
// Todos os models abaixo estão definidos no schema principal
// do backend DigiUrban e são compartilhados por este serviço

model MessageServer {
  id                String   @id @default(cuid())
  name              String
  hostname          String
  wsPort            Int      @default(9001)
  isActive          Boolean  @default(false)
  maxDailyMessages  Int      @default(100000)
  enableEncryption  Boolean  @default(false)
  enableP2P         Boolean  @default(false)
  enableBroadcast   Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversations Conversation[]
  channels      OfficialChannel[]
  logs          MessageLog[]
  stats         MessageStats[]

  @@map("message_servers")
}

model Conversation {
  id              String             @id @default(cuid())
  messageServerId String
  participant1Id   String
  participant1Type ParticipantType
  participant2Id   String
  participant2Type ParticipantType
  protocolId       String?
  departmentId     String?
  type             ConversationType @default(SUPPORT)
  status           ConversationStatus @default(ACTIVE)
  lastMessageAt    DateTime?
  lastMessagePreview String?
  totalMessages    Int      @default(0)
  unreadCount1     Int      @default(0)
  unreadCount2     Int      @default(0)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  closedAt         DateTime?

  messageServer MessageServer @relation(fields: [messageServerId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([participant1Id, participant1Type, participant2Id, participant2Type, protocolId])
  @@index([participant1Id, participant1Type, status])
  @@index([participant2Id, participant2Type, status])
  @@index([protocolId])
  @@index([status, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  senderType     ParticipantType
  content        String   @db.Text
  contentType    MessageContentType @default(TEXT)
  attachments    Json?
  replyToId      String?
  status         MessageStatus @default(SENT)
  sentAt         DateTime @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  isEdited       Boolean  @default(false)
  editedAt       DateTime?
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  reports        MessageReport[]

  @@index([conversationId, sentAt])
  @@index([senderId, senderType])
  @@index([status, sentAt])
  @@index([isDeleted])
  @@map("messages")
}

model OfficialChannel {
  id              String   @id @default(cuid())
  messageServerId String
  name            String
  slug            String   @unique
  description     String?  @db.Text
  iconUrl         String?
  bannerUrl       String?
  color           String?
  departmentId    String?
  managedBy       Json
  isPublic        Boolean  @default(true)
  requiresApproval Boolean @default(false)
  isActive        Boolean  @default(true)
  allowComments   Boolean  @default(false)
  subscriberCount Int      @default(0)
  messageCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messageServer   MessageServer @relation(fields: [messageServerId], references: [id], onDelete: Cascade)
  subscriptions   ChannelSubscription[]
  messages        ChannelMessage[]

  @@index([isActive, isPublic])
  @@index([slug])
  @@map("official_channels")
}

model ChannelSubscription {
  id         String   @id @default(cuid())
  channelId  String
  citizenId  String
  status     ChannelSubscriptionStatus @default(PENDING)
  subscribedAt DateTime @default(now())
  approvedAt   DateTime?
  approvedBy   String?
  notifyInApp   Boolean @default(true)
  notifyEmail   Boolean @default(false)
  notifySMS     Boolean @default(false)
  notifyPush    Boolean @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  channel       OfficialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveries    ChannelDelivery[]

  @@unique([channelId, citizenId])
  @@index([citizenId, status])
  @@index([channelId, status])
  @@map("channel_subscriptions")
}

model ChannelMessage {
  id         String   @id @default(cuid())
  channelId  String
  authorId   String
  title      String?
  content    String   @db.Text
  contentType MessageContentType @default(TEXT)
  attachments Json?
  scheduledFor DateTime?
  publishedAt  DateTime?
  status       BroadcastStatus @default(DRAFT)
  deliveredCount Int @default(0)
  readCount      Int @default(0)
  failedCount    Int @default(0)
  priority       Int @default(3)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sentAt         DateTime?

  channel        OfficialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveries     ChannelDelivery[]

  @@index([channelId, publishedAt])
  @@index([status, scheduledFor])
  @@index([authorId])
  @@map("channel_messages")
}

model ChannelDelivery {
  id        String   @id @default(cuid())
  messageId String
  subscriptionId String
  citizenId String
  status    MessageStatus @default(QUEUED)
  queuedAt  DateTime @default(now())
  sentAt    DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  errorMessage String?
  retryCount   Int @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  message      ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  subscription ChannelSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([messageId, citizenId])
  @@index([messageId, status])
  @@index([citizenId, status])
  @@index([status, queuedAt])
  @@map("channel_deliveries")
}

model CitizenPrivacySettings {
  citizenId            String   @id
  allowMessagesFromAll Boolean  @default(false)
  allowMessagesFromServers Boolean @default(true)
  blockedCitizens      Json     @default("[]")
  blockedServers       Json     @default("[]")
  notifyNewMessage     Boolean  @default(true)
  notifySound          Boolean  @default(true)
  notifyVibrate        Boolean  @default(true)
  showOnlineStatus     Boolean  @default(true)
  showLastSeen         Boolean  @default(true)
  showReadReceipts     Boolean  @default(true)
  autoBackup           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("citizen_privacy_settings")
}

model MessageReport {
  id          String   @id @default(cuid())
  messageId   String
  reportedBy  String
  reporterType ParticipantType
  reason      ReportReason
  description String?  @db.Text
  status      ReportStatus @default(PENDING)
  screenshots Json?
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewNotes String?  @db.Text
  action      ModerationAction?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([reportedBy, reporterType])
  @@index([status, createdAt])
  @@map("message_reports")
}

model MessageLog {
  id              String   @id @default(cuid())
  messageServerId String?
  level           LogLevel @default(INFO)
  event           String
  userId          String?
  citizenId       String?
  conversationId  String?
  messageId       String?
  channelId       String?
  message         String   @db.Text
  data            Json?
  ipAddress       String?
  userAgent       String?
  timestamp       DateTime @default(now())

  messageServer   MessageServer? @relation(fields: [messageServerId], references: [id], onDelete: SetNull)

  @@index([messageServerId, timestamp])
  @@index([event, timestamp])
  @@index([level, timestamp])
  @@index([userId])
  @@index([citizenId])
  @@map("message_logs")
}

model MessageStats {
  id              String   @id @default(cuid())
  messageServerId String
  date            DateTime @db.Date
  hour            Int?
  totalMessages        Int @default(0)
  textMessages         Int @default(0)
  mediaMessages        Int @default(0)
  deletedMessages      Int @default(0)
  totalConversations   Int @default(0)
  newConversations     Int @default(0)
  closedConversations  Int @default(0)
  activeUsers          Int @default(0)
  activeCitizens       Int @default(0)
  onlineUsers          Int @default(0)
  channelMessages      Int @default(0)
  channelSubscriptions Int @default(0)
  channelDeliveries    Int @default(0)
  avgResponseTime      Float?
  avgMessageLength     Float?
  reportsCreated       Int @default(0)
  reportsResolved      Int @default(0)
  usersBlocked         Int @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  messageServer        MessageServer @relation(fields: [messageServerId], references: [id], onDelete: Cascade)

  @@unique([messageServerId, date, hour])
  @@index([messageServerId, date])
  @@map("message_stats")
}

model WebSocketSession {
  id          String   @id @default(cuid())
  socketId    String   @unique
  userId      String?
  userType    ParticipantType
  ipAddress   String
  userAgent   String?
  connectedAt DateTime @default(now())
  lastPingAt  DateTime @default(now())
  isOnline    Boolean  @default(true)
  metadata    Json?
  disconnectedAt DateTime?

  @@index([userId, userType, isOnline])
  @@index([connectedAt])
  @@map("websocket_sessions")
}

model MessageTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  category    TemplateCategory
  title       String?
  content     String   @db.Text
  contentType MessageContentType @default(TEXT)
  variables   Json     @default("[]")
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("message_templates")
}

// Enums compartilhados
enum ParticipantType {
  CITIZEN
  SERVER
  SYSTEM
}

enum ConversationType {
  SUPPORT
  P2P
  GROUP
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
  BLOCKED
}

enum MessageContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  STICKER
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ChannelSubscriptionStatus {
  PENDING
  ACTIVE
  MUTED
  BLOCKED
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  INAPPROPRIATE_CONTENT
  SCAM
  IMPERSONATION
  VIOLENCE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ModerationAction {
  NONE
  WARNING
  MESSAGE_DELETED
  USER_WARNED
  USER_SUSPENDED
  USER_BANNED
  REPORTED_POLICE
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}

enum TemplateCategory {
  WELCOME
  PROTOCOL
  NOTIFICATION
  REMINDER
  CONFIRMATION
  ALERT
  SYSTEM
}
