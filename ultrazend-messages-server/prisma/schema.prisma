// Unidades de Saúde (UBS, UPA, Hospitais, etc.) - ATUALIZADO
model UnidadeSaude {
  id                String           @id @default(cuid())
  nome              String
  tipo              String // 'UBS', 'UPA', 'Hospital', 'Clínica', 'Posto', 'Outro'
  fluxoAtendimento  FluxoAtendimento @default(TRADICIONAL) // ✅ NOVO: Tipo de fluxo de atendimento
  cnes              String? // ✅ NOVO: Cadastro Nacional de Estabelecimentos de Saúde
  cnpj              String? // ✅ NOVO: CNPJ da unidade
  endereco          String?
  bairro            String?
  cidade            String? // ✅ NOVO
  estado            String? // ✅ NOVO
  cep               String? // ✅ NOVO
  telefone          String?
  email             String? // ✅ NOVO
  horario           String?
  horarioAbertura   String? // ✅ NOVO: Ex: "07:00"
  horarioFechamento String? // ✅ NOVO: Ex: "17:00"
  especialidades    Json? // Array de especialidades disponíveis
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // ✅ NOVO: Vínculo com Sistema Unificado V2.0
  organizationalUnitId String?             @unique
  organizationalUnit   OrganizationalUnit? @relation("UnidadeSaudeOrgUnit", fields: [organizationalUnitId], references: [id], onDelete: SetNull)

  // Relacionamentos - Apps Saúde
  chamadas              ChamadaPainel[]
  imunizacoes           ImunizacaoCidadao[]
  lotesMedicamentos     LoteMedicamento[]
  transferenciasOrigem  TransferenciaEstoque[] @relation("StockTransferOrigin")
  transferenciasDestino TransferenciaEstoque[] @relation("StockTransferDestination")
  alertasEstoque        AlertaEstoque[]

  // ✅ NOVOS: Relacionamentos com cadastros
  salas               SalaConsultorio[]
  configuracao        ConfiguracaoAtendimento?
  atividadesColetivas AtividadeColetiva[]      @relation("UnidadeAtividadesColetivas")

  // ✅ FLUXO DE ATENDIMENTO PEC e-SUS
  equipes            EquipeSaude[]
  filaAtendimentos   FilaAtendimento[]
  escutasIniciais    EscutaInicial[]
  triagens           TriagemEnfermagem[]
  configuracaoAgenda ConfiguracaoAgenda[]

  @@index([tipo, isActive])
  @@index([isActive])
  @@index([cnes])
  @@index([organizationalUnitId])
  @@map("unidades_saude")
}

