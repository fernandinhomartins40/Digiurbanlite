// ============================================
// ESTRUTURA ORGANIZACIONAL
// ============================================

model OrganizationalUnit {
  id    String                    @id @default(cuid())
  nome  String
  sigla String?
  tipo  TipoUnidadeOrganizacional // SECRETARIA, DIRETORIA, COORDENADORIA, DIVISAO, SETOR
  nivel Int // Nível hierárquico (1=Secretaria, 2=Diretoria, etc)

  departmentId String
  department   Department @relation("DepartmentOrganizationalUnits", fields: [departmentId], references: [id])

  // Hierarquia (auto-relacionamento)
  parentId String?
  parent   OrganizationalUnit?  @relation("UnidadeHierarquia", fields: [parentId], references: [id])
  children OrganizationalUnit[] @relation("UnidadeHierarquia")

  // Responsável pela unidade
  responsavelId String?
  responsavel   User?   @relation("ResponsavelUnidade", fields: [responsavelId], references: [id])

  // Dados complementares
  descricao    String?
  competencias Json? // Array de competências da unidade
  endereco     String?
  telefone     String?
  email        String?

  // Status
  isActive Boolean @default(true)

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relacionamentos
  positions   Position[]
  assignments EmployeeAssignment[]
  teams       Team[]
  hierarchies EmployeeHierarchy[]

  // ✅ Relacionamento com apps de domínio específico
  unidadeSaude    UnidadeSaude?    @relation("UnidadeSaudeOrgUnit")
  unidadeEducacao UnidadeEducacao? @relation("UnidadeEducacaoOrgUnit")
  unidadeCRAS     UnidadeCRAS?     @relation("UnidadeCRASOrgUnit")

  // ✅ NOVO: Sistema de Atribuição de Protocolos
  protocolAssignments ProtocolServerAssignment[] @relation("ProtocolUnitAssignments")
  protocols           ProtocolSimplified[]       @relation("ProtocolOrganizationalUnits")

  @@unique([departmentId, sigla])
  @@index([departmentId, tipo, isActive])
  @@index([parentId])
  @@map("organizational_units")
}

enum TipoUnidadeOrganizacional {
  SECRETARIA
  DIRETORIA
  COORDENADORIA
  DIVISAO
  SETOR
  NUCLEO
  GERENCIA
  UNIDADE_ESPECIAL
  DEPARTAMENTO
  ASSESSORIA
}

// ============================================
// CARGOS E FUNÇÕES
// ============================================

model Position {
  id        String  @id @default(cuid())
  nome      String
  descricao String?
  cbo       String? // Classificação Brasileira de Ocupações

  tipo      TipoCargo // EFETIVO, COMISSIONADO, TEMPORARIO, ESTAGIARIO
  categoria String? // "Médico", "Professor", "Engenheiro", etc
  nivel     NivelCargo? // BASICO, TECNICO, SUPERIOR, GERENCIAL, DIRECAO

  requisitos  Json? // Escolaridade, experiência, certificações
  atribuicoes Json? // Array de atribuições do cargo

  departmentId String
  department   Department @relation("DepartmentPositions", fields: [departmentId], references: [id])

  organizationalUnitId String?
  organizationalUnit   OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id])

  cargaHorariaPadrao Int?     @default(40) // Horas semanais padrão
  salarioBase        Decimal? @db.Decimal(10, 2) // Salário base do cargo

  // Status
  isActive Boolean @default(true)

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relacionamentos
  assignments EmployeeAssignment[]

  @@unique([departmentId, nome])
  @@index([departmentId, tipo, isActive])
  @@index([organizationalUnitId])
  @@map("positions")
}

enum TipoCargo {
  EFETIVO
  COMISSIONADO
  TEMPORARIO
  CONTRATADO
  ESTAGIARIO
  VOLUNTARIO
}

enum NivelCargo {
  OPERACIONAL
  TECNICO
  ANALISTA
  ESPECIALISTA
  COORDENACAO
  GERENCIA
  DIRECAO
  SECRETARIADO
}

model Function {
  id        String  @id @default(cuid())
  nome      String
  descricao String?

  tipo    TipoFuncao // GRATIFICADA, COMISSIONADA, DESIGNACAO
  simbolo String? // FG-1, CC-2, etc
  valor   Decimal?   @db.Decimal(10, 2) // Valor da gratificação

  departmentId String
  department   Department @relation("DepartmentFunctions", fields: [departmentId], references: [id])

  requisitos  Json?
  atribuicoes Json?

  // Status
  isActive Boolean @default(true)

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relacionamentos
  assignments EmployeeAssignment[]

  @@unique([departmentId, simbolo])
  @@index([departmentId, tipo, isActive])
  @@map("functions")
}

enum TipoFuncao {
  GRATIFICADA // Função gratificada
  COMISSIONADA // Cargo em comissão
  DESIGNACAO // Designação temporária
  REPRESENTACAO // Representação institucional
}

// ============================================
// VÍNCULOS FUNCIONAIS (SISTEMA UNIFICADO)
// ============================================

model EmployeeAssignment {
  id String @id @default(cuid())

  userId String
  user   User   @relation("ServidorVinculos", fields: [userId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation("DepartmentAssignments", fields: [departmentId], references: [id])

  organizationalUnitId String?
  organizationalUnit   OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id])

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])

  functionId String?
  function   Function? @relation(fields: [functionId], references: [id])

  tipo     TipoVinculo // LOTACAO, CEDENCIA, REQUISICAO, REMOCAO
  situacao SituacaoVinculo // ATIVO, AFASTADO, LICENCA, SUSPENSO

  isPrimary Boolean @default(false) // Vínculo principal do servidor

  dataInicio DateTime
  dataFim    DateTime?

  cargaHoraria        Int? // Horas semanais
  percentualDedicacao Int? // 0-100%

  observacoes      String?
  documentoVinculo String? // Portaria, decreto, etc

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relacionamentos
  auditorias AssignmentAudit[]

  // ✅ NOVO: Sistema de Atribuição de Protocolos
  protocolAssignments ProtocolServerAssignment[] @relation("ProtocolEmployeeAssignments")

  @@unique([userId, organizationalUnitId, positionId, dataInicio])
  @@index([userId, isPrimary, situacao])
  @@index([departmentId, situacao])
  @@index([organizationalUnitId, situacao])
  @@index([positionId])
  @@index([situacao])
  @@map("employee_assignments")
}

enum TipoVinculo {
  LOTACAO // Lotação regular
  CEDENCIA // Cedido a outro órgão
  REQUISICAO // Requisitado de outro órgão
  REMOCAO // Remoção interna
  DISPOSICAO // À disposição
}

enum SituacaoVinculo {
  ATIVO
  AFASTADO // Afastamento temporário
  LICENCA // Licença médica/prêmio
  SUSPENSO // Suspensão disciplinar
  CEDIDO // Cedido a outro órgão
  INATIVO
}

// ============================================
