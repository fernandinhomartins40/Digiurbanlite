// ✅ CONFIGURAÇÃO DE INTEGRAÇÃO e-SUS
model ConfiguracaoESUS {
  id          String @id @default(cuid())
  municipioId String @unique // Vinculado ao município

  // Configurações de Integração
  integracaoAtiva Boolean            @default(false)
  tipoIntegracao  TipoIntegracaoESUS @default(NENHUMA)

  // Credenciais API REST (PEC v5.3.19+)
  urlPEC     String? // URL da instalação PEC (ex: https://esus.cidade.gov.br)
  usuarioAPI String? // Usuário gerado pelo administrador PEC
  senhaAPI   String? // Senha (será criptografada no backend)

  // Configurações LEDI (Thrift/XML)
  formatoLEDI         FormatoLEDI?
  versaoLEDI          String? // Ex: "6.3.8"
  diretorioExportacao String? // Caminho para salvar arquivos LEDI

  // Mapeamentos
  cnesUnidadePrincipal    String? // CNES da unidade principal
  mapeamentoUnidades      Json? // {digiurbanId: cnes}
  mapeamentoProfissionais Json? // {digiurbanId: cns}

  // Sincronização
  sincronizacaoAutomatica Boolean   @default(false)
  intervaloSincMinutos    Int       @default(60)
  ultimaSincronizacao     DateTime?
  proximaSincronizacao    DateTime?

  // Logs e Auditoria
  logTransmissoes      Boolean @default(true)
  retentarEnviosFalhos Boolean @default(true)
  maxTentativas        Int     @default(3)

  // Observações
  observacoes String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relacionamentos
  transmissoes TransmissaoESUS[]

  @@index([integracaoAtiva])
  @@map("configuracoes_esus")
}

// ✅ REGISTRO DE TRANSMISSÕES e-SUS
model TransmissaoESUS {
  id             String @id @default(cuid())
  configuracaoId String

  // Identificação
  tipo    TipoFichaESUS
  formato FormatoLEDI?

  // Dados de Origem
  fichaId        String // ID do registro DigiUrban (atendimentoId, consultaId, etc)
  entidadeOrigem String? // Nome da entidade (AtendimentoMedico, ConsultaMedica, etc)
  nomeArquivo    String? // Nome do arquivo gerado (se LEDI)

  // Conteúdo (para auditoria)
  payloadJSON  Json? // Dados serializados antes da conversão
  conteudoLEDI String? @db.Text // Conteúdo LEDI (XML ou Base64 do Thrift)

  // Status e Resposta
  status          StatusTransmissao @default(PENDENTE)
  dataEnvio       DateTime          @default(now())
  dataConfirmacao DateTime?

  // Resposta do PEC
  codigoResposta   Int?
  mensagemResposta String?
  erros            Json? // Erros de validação retornados pelo PEC

  // Retry
  tentativas       Int       @default(0)
  proximaTentativa DateTime?
  ultimaFalha      DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  configuracao ConfiguracaoESUS @relation(fields: [configuracaoId], references: [id])

  @@index([configuracaoId, status])
  @@index([dataEnvio])
  @@index([fichaId])
  @@index([status, proximaTentativa])
  @@map("transmissoes_esus")
}

// ✅ ENUMS de Integração e-SUS
enum TipoIntegracaoESUS {
  API_REST // Envio via API REST (PEC v5.3.19+)
  LEDI_THRIFT // Arquivo Thrift
  LEDI_XML // Arquivo XML
  NENHUMA
}

enum FormatoLEDI {
  THRIFT
  XML
}

enum TipoFichaESUS {
  CADASTRO_INDIVIDUAL
  CADASTRO_DOMICILIAR
  ATENDIMENTO_INDIVIDUAL
  ATENDIMENTO_ODONTOLOGICO
  ATENDIMENTO_DOMICILIAR
  VISITA_DOMICILIAR
  ATIVIDADE_COLETIVA
  PROCEDIMENTOS
  VACINACAO
}

enum StatusTransmissao {
  PENDENTE
  ENVIANDO
  SUCESSO
  ERRO_VALIDACAO
  ERRO_CONEXAO
  ERRO_AUTENTICACAO
  AGUARDANDO_RETRY
  CANCELADO
}

// ============================================================================
// FLUXO DE ATENDIMENTO PEC e-SUS - NOVAS TABELAS
// ============================================================================

// ✅ EQUIPES DE SAÚDE (PSF/ESF)
model EquipeSaude {
  id String @id @default(cuid())

  // Identificação
  ine  String     @unique // Identificação Nacional de Equipes
  nome String
  tipo TipoEquipe

  // Vinculação
  unidadeId String
  unidade   UnidadeSaude @relation(fields: [unidadeId], references: [id])

  // ✅ NOVO: Vínculo com Sistema Unificado V2.0
  teamId String? @unique
  team   Team?   @relation("EquipeSaudeTeam", fields: [teamId], references: [id], onDelete: SetNull)

  // Status
  ativo Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relacionamentos
  microareas      Microarea[]
  profissionais   ProfissionalEquipe[]
  citizens        Citizen[]            @relation("CitizenEquipe")
  filaAtendimento FilaAtendimento[]
  escutasIniciais EscutaInicial[]

  @@index([unidadeId])
  @@index([ativo])
  @@index([teamId])
  @@map("equipes_saude")
}

enum FluxoAtendimento {
  TRADICIONAL // UPA ou UBS sem ESF - profissional individual
  ESF // UBS com ESF - atendimento por equipe
  MISTO // UBS mista - ambos os modelos
}

enum TipoEquipe {
  eAP // Equipe de Atenção Primária
  eSF // Equipe Saúde da Família
  eAB // Equipe Atenção Básica
  NASF // Núcleo Apoio Saúde Família
  eCR // Equipe Consultório de Rua
  eAD // Equipe Atenção Domiciliar
}

// ✅ VÍNCULO PROFISSIONAL-EQUIPE
model ProfissionalEquipe {
  id String @id @default(cuid())

  profissionalId String
  profissional   User   @relation("ProfissionalEquipes", fields: [profissionalId], references: [id])

  equipeId String
  equipe   EquipeSaude @relation(fields: [equipeId], references: [id])

  // Função na equipe
  cbo    String // Código CBO do profissional
  funcao String? // Descrição da função

  // Período
  dataInicio DateTime  @default(now())
  dataFim    DateTime?
  ativo      Boolean   @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profissionalId, equipeId, dataInicio])
  @@index([profissionalId])
  @@index([equipeId])
  @@index([ativo])
  @@map("profissionais_equipes")
}

// ✅ MICROÁREAS (TERRITORIALIZAÇÃO)
model Microarea {
  id String @id @default(cuid())

  // Identificação
  numero    String
  descricao String?

  // Vinculação
  equipeId String
  equipe   EquipeSaude @relation(fields: [equipeId], references: [id])

  // ACS Responsável
  acsId String?
  acs   User?   @relation("ACSMicroarea", fields: [acsId], references: [id])

  // Status
  ativo Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  citizens Citizen[] @relation("CitizenMicroarea")

  @@unique([equipeId, numero])
  @@index([equipeId])
  @@index([acsId])
  @@map("microareas")
}

// ✅ FILA DE ATENDIMENTO (LISTA DE PACIENTES)
model FilaAtendimento {
  id String @id @default(cuid())

  // Cidadão
  citizenId String
  citizen   Citizen @relation("CitizenFilaAtendimentos", fields: [citizenId], references: [id])

  // Profissional responsável
  profissionalId String
  profissional   User   @relation("ProfissionalFilaAtendimentos", fields: [profissionalId], references: [id])

  // Equipe (se aplicável)
  equipeId String?
  equipe   EquipeSaude? @relation(fields: [equipeId], references: [id])

  // Tipo e motivo
  tipoAtendimento TipoAtendimento
  motivoBusca     String

  // Status do fluxo
  status     StatusFila     @default(AGUARDANDO)
  prioridade PrioridadeFila @default(NORMAL)

  // ✅ NOVO: Classificação de Risco (UPA - Protocolo de Manchester)
  classificacaoRisco     ClassificacaoRisco? // Cor Manchester
  dataClassificacaoRisco DateTime? // Quando foi classificado
  queixaPrincipal        String? // Queixa principal do paciente
  sinaisVitais           Json? // PA, FC, FR, Temp, SatO2, Glicemia

  // ✅ NOVO: Acolhimento (UBS)
  condutaAcolhimento   CondutaAcolhimento? // Decisão do acolhimento
  dataAcolhimento      DateTime? // Quando foi acolhido
  resolvidoAcolhimento Boolean             @default(false) // Se foi resolvido no acolhimento

  // Datas e horários
  dataHoraChegada DateTime  @default(now())
  dataHoraInicio  DateTime?
  dataHoraFim     DateTime?

  // Flags especiais
  vacinacao Boolean @default(false)

  // Observações
  observacoes String?

  // Unidade
  unidadeId String
  unidade   UnidadeSaude @relation(fields: [unidadeId], references: [id])

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relacionamentos
  escutaInicial     EscutaInicial?
  triagem           TriagemEnfermagem?
  atendimento       AtendimentoMedico? @relation("FilaAtendimento")
  consultaAgendadas ConsultaAgendada[]
  chamadaPainels    ChamadaPainel[]

  @@index([citizenId])
  @@index([profissionalId])
  @@index([equipeId])
  @@index([unidadeId])
  @@index([status])
  @@index([dataHoraChegada])
  @@index([prioridade])
  @@map("fila_atendimento")
}

enum TipoAtendimento {
  AGENDADO
  DEMANDA_ESPONTANEA
  URGENCIA
  RETORNO
  RENOVACAO_RECEITA
  VACINACAO
  PROCEDIMENTO
}

enum StatusFila {
  // Status iniciais
  AGUARDANDO // Paciente chegou, aguardando primeiro atendimento

  // UPA - Classificação de Risco (Manchester)
  EM_CLASSIFICACAO_RISCO // Em classificação de risco (UPA)
  AGUARDANDO_ATENDIMENTO // Classificado, aguardando atendimento

  // UBS - Acolhimento
  EM_ACOLHIMENTO // Em acolhimento (UBS)
  RESOLVIDO_ACOLHIMENTO // Resolvido no acolhimento

  // Fluxo comum
  EM_ESCUTA_INICIAL // Em escuta inicial (depreciado - usar EM_ACOLHIMENTO)
  EM_TRIAGEM // Em triagem de enfermagem (depreciado - usar EM_CLASSIFICACAO_RISCO)
  AGUARDANDO_MEDICO // Aguardando médico (depreciado - usar AGUARDANDO_ATENDIMENTO)
  EM_CONSULTA // Em consulta médica
  EM_PROCEDIMENTO // Em sala de procedimentos
  EM_VACINACAO // Em vacinação

  // Finalizações
  FINALIZADO // Atendimento concluído
  ENCAMINHADO_EXTERNO // Encaminhado para outra unidade/especialista
  INTERNADO // Paciente internado
  NAO_AGUARDOU // Desistiu da espera
  RETORNOU // Retornou após não aguardar
  TRANSFERIDO // Transferido para outro serviço
}

enum PrioridadeFila {
  NORMAL
  URGENTE
  MUITO_URGENTE
  EMERGENCIA
}

// ✅ NOVO: Classificação de Risco (Protocolo de Manchester)
enum ClassificacaoRisco {
  VERMELHO // Emergência - 0 minutos
  LARANJA // Muito urgente - 10 minutos
  AMARELO // Urgente - 60 minutos
  VERDE // Pouco urgente - 120 minutos
  AZUL // Não urgente - 240 minutos
}

// ✅ NOVO: Conduta do Acolhimento
enum CondutaAcolhimento {
  RESOLVER_ACOLHIMENTO // Resolver no próprio acolhimento
  ENCAMINHAR_MEDICO // Encaminhar para consulta médica
  ENCAMINHAR_ENFERMEIRO // Encaminhar para enfermeiro
  ENCAMINHAR_PROCEDIMENTO // Encaminhar para procedimento
  AGENDAR_CONSULTA // Agendar consulta futura
  ENCAMINHAR_EXTERNO // Encaminhar para outra unidade
  ORIENTACAO // Apenas orientação
}

// ✅ ESCUTA INICIAL / ACOLHIMENTO
model EscutaInicial {
  id String @id @default(cuid())

  // Vinculação com fila
  filaAtendimentoId String          @unique
  filaAtendimento   FilaAtendimento @relation(fields: [filaAtendimentoId], references: [id])

  // Profissional que realizou (geralmente enfermeiro/técnico)
  profissionalId String
  profissional   User   @relation("ProfissionalEscutasIniciais", fields: [profissionalId], references: [id])

  // Equipe
  equipeId String?
  equipe   EquipeSaude? @relation(fields: [equipeId], references: [id])

  // === SUBJETIVO ===
  motivoBusca          String
  historiaBreve        String?
  tempoEvolucao        String?
  tentativasAnteriores String?

  // === OBJETIVO (OPCIONAL) ===
  pressaoArterial    String?
  temperatura        Float?
  frequenciaCardiaca Int?
  observacoesVisuais String?

  // === CLASSIFICAÇÃO ===
  // Risco Biológico
  riscoEsperado RiscoEsperado

  // Vulnerabilidade Social
  vulnerabilidadeSocial VulnerabilidadeSocial

  // === CONDUTA ===
  condutaDefinida CondutaEscutaInicial

  // Se encaminhado para profissional
  profissionalEncaminhadoId String?
  profissionalEncaminhado   User?   @relation("EncaminhamentosEscutaInicial", fields: [profissionalEncaminhadoId], references: [id])

  // Se agendamento
  dataAgendamento DateTime?

  // Orientações fornecidas
  orientacoes String?

  // Unidade
  unidadeId String
  unidade   UnidadeSaude @relation(fields: [unidadeId], references: [id])

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filaAtendimentoId])
  @@index([profissionalId])
  @@index([unidadeId])
  @@index([riscoEsperado])
  @@index([condutaDefinida])
  @@map("escutas_iniciais")
}

enum RiscoEsperado {
  EMERGENCIA // 🔴 Atendimento imediato
  MUITO_URGENTE // 🟠
  URGENTE // 🟡
  POUCO_URGENTE // 🟢
  NAO_URGENTE // ⚪
}

enum VulnerabilidadeSocial {
  ALTA
  MEDIA
  BAIXA
}

enum CondutaEscutaInicial {
  RESOLVIDO_NA_ESCUTA // Orientações foram suficientes
  ENCAMINHADO_ATENDIMENTO_DIA // Vai para triagem/médico hoje
  PROCEDIMENTO_UBS // Curativo, inalação, etc.
  AGENDAMENTO_CONSULTA // Agendar para outro dia
  ENCAMINHAMENTO_EXTERNO // Especialidade, urgência externa
}

// ✅ TRIAGEM DE ENFERMAGEM
model TriagemEnfermagem {
  id String @id @default(cuid())

  // Vinculação com fila
  filaAtendimentoId String          @unique
  filaAtendimento   FilaAtendimento @relation(fields: [filaAtendimentoId], references: [id])

  // Enfermeiro responsável
  enfermeiroId String
  enfermeiro   User   @relation("EnfermeiroTriagens", fields: [enfermeiroId], references: [id])

  // === SINAIS VITAIS ===
  pressaoArterial        String? // Formato: 120/80
  temperatura            Float? // °C
  frequenciaCardiaca     Int? // bpm
  frequenciaRespiratoria Int? // irpm
  saturacaoO2            Float? // %
  dor                    Int? // Escala 0-10

  // === ANTROPOMETRIA ===
  peso                    Float? // kg
  altura                  Float? // cm
  imc                     Float? // Calculado automaticamente
  perimetroCefalico       Float? // cm (crianças)
  circunferenciaAbdominal Float? // cm

  // === GLICEMIA CAPILAR ===
  glicemiaCapilar Float? // mg/dL
  momentoGlicemia MomentoGlicemia?

  // === AVALIAÇÃO DE ENFERMAGEM ===
  queixaPrincipal     String
  historiaDoencaAtual String?
  alergiasConhecidas  String?
  medicamentosUso     String?
  comorbidades        String?

  // === CLASSIFICAÇÃO DE RISCO (MANCHESTER) ===
  classificacaoRisco     ClassificacaoManchester
  discriminadorUtilizado String? // Qual discriminador foi usado

  // === ENCAMINHAMENTO ===
  profissionalEncaminhadoId String?
  profissionalEncaminhado   User?   @relation("EncaminhamentosTriagem", fields: [profissionalEncaminhadoId], references: [id])

  observacoes String?

  // Unidade
  unidadeId String
  unidade   UnidadeSaude @relation(fields: [unidadeId], references: [id])

  // Audit
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  atendimentoMedicos AtendimentoMedico[]

  @@index([filaAtendimentoId])
  @@index([enfermeiroId])
  @@index([unidadeId])
  @@index([classificacaoRisco])
  @@map("triagens_enfermagem")
}

enum MomentoGlicemia {
  JEJUM
  POS_PRANDIAL
  ALEATORIA
}

enum ClassificacaoManchester {
  EMERGENCIA // 🔴 Imediato (0min)
  MUITO_URGENTE // 🟠 10 minutos
  URGENTE // 🟡 60 minutos
  POUCO_URGENTE // 🟢 120 minutos
  NAO_URGENTE // 🔵 240 minutos
}

// ✅ ATIVIDADE COLETIVA
model AtividadeColetiva {
  id String @id @default(cuid())

  // Identificação
  tipo      TipoAtividadeColetiva
  tema      String
  descricao String?

  // Data e local
