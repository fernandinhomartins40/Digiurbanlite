generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CONFIGURAÇÃO DO MUNICÍPIO (SINGLETON)
// ============================================
model MunicipioConfig {
  id               String    @id @default("singleton")
  nome             String
  cnpj             String    @unique
  codigoIbge       String?
  nomeMunicipio    String
  ufMunicipio      String
  brasao           String?
  corPrimaria      String?
  configuracoes    Json?
  isActive         Boolean   @default(true)
  isSuspended      Boolean   @default(false)
  suspensionReason String?
  paymentStatus    String    @default("active") // active, pending, overdue, suspended
  subscriptionPlan String    @default("basic") // basic, professional, enterprise
  subscriptionEnds DateTime?
  maxUsers         Int       @default(10)
  maxCitizens      Int       @default(10000)
  features         Json? // Features habilitadas
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("municipio_config")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  password            String
  role                UserRole  @default(USER)
  isActive            Boolean   @default(true)
  departmentId        String? // ✅ MANTIDO: compatibilidade (primary department)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastLogin           DateTime?

  // ✅ DADOS DE SERVIDOR PÚBLICO (Sistema Unificado)
  cpf                String?   @unique // CPF do servidor
  matricula          String?   @unique // Matrícula funcional
  rg                 String? // RG
  dataNascimento     DateTime? // Data de nascimento
  telefone           String? // Telefone principal
  telefoneSecundario String? // Telefone secundário
  endereco           Json? // Endereço completo
  cargoEfetivo       String? // Cargo de concurso (ex: "Médico", "Professor")
  situacaoFuncional  String? // ATIVO, APOSENTADO, EXONERADO, etc
  dataAdmissao       DateTime? // Data de admissão no serviço público
  observacoes        String? // Observações gerais

  // Relacionamentos
  agendaEvents                AgendaEvent[]            @relation("AgendaEventCreator")
  auditLogs                   AuditLog[]
  reviewedTransferRequests    CitizenTransferRequest[]
  createdProtocolsSimplified  ProtocolSimplified[]     @relation("CreatedByUserSimplified")
  assignedProtocolsSimplified ProtocolSimplified[]     @relation("AssignedUserSimplified")
  department                  Department?              @relation("UserPrimaryDepartment", fields: [departmentId], references: [id])

  // ✅ NOVO: Múltiplos departamentos (N:N)
  userDepartments UserDepartment[]

  // Chamados administrativos
  requestedTickets AdminTicket[] @relation("TicketRequester")
  assignedTickets  AdminTicket[] @relation("TicketAssigned")

  // Recuperação de senha
  passwordResetTokens PasswordResetToken[]

  // Email drafts
  emailDrafts EmailDraft[]

  // Categorias de cidadãos atribuídas por este usuário
  categoryAssignments CitizenCategoryAssignment[] @relation("CategoryAssignedBy")

  // Auditoria de campos de dados
  fieldApprovals FieldApproval[] @relation("FieldApprovals")
  fieldChanges   FieldChange[]   @relation("FieldChanges")

  // Certificados digitais
  certificates DigitalCertificate[] @relation("UserCertificates")

  // Revogações de certificados
  revokedCertificates CertificateRevocationList[] @relation("CRLRevokedBy")

  // Documentos externos para assinatura
  externalDocuments ExternalDocument[] @relation("UserExternalDocuments")

  // Solicitações de certificados
  certificateRequests         CertificateRequest[] @relation("UserCertificateRequests")
  reviewedCertificateRequests CertificateRequest[] @relation("CertificateRequestReviewer")

  // Apps Saúde - Registros médicos
  allergyRecords     AlergiasCidadao[]     @relation("UserAllergyRecords")
  comorbidityRecords ComorbidadesCidadao[] @relation("UserComorbidityRecords")
  attachmentUploads  AnexoProntuario[]     @relation("UserAttachmentUploads")

  // Apps Saúde - Farmácia
  medicationLots         LoteMedicamento[]      @relation("UserMedicationLots")
  stockTransferRequester TransferenciaEstoque[] @relation("UserStockTransferRequester")
  stockTransferConfirmer TransferenciaEstoque[] @relation("UserStockTransferConfirmer")

  // Apps Saúde - TFD
  tfdDocuments           DocumentoTFD[]          @relation("UserTFDDocuments")
  tfdRegulations         ParecerRegulacaoTFD[]   @relation("UserTFDRegulations")
  tfdManagementApprovals AprovacaoGestaoTFD[]    @relation("UserTFDManagementApprovals")
  tfdExternalSchedules   AgendamentoExternoTFD[] @relation("UserTFDExternalSchedules")
  tfdExpenseReports      PrestacaoContasTFD[]    @relation("UserTFDExpenseReports")
  tfdExpenseApprovals    PrestacaoContasTFD[]    @relation("UserTFDExpenseApprovals")

  // ✅ FLUXO DE ATENDIMENTO PEC e-SUS
  equipesVinculadas      ProfissionalEquipe[]            @relation("ProfissionalEquipes")
  microareasResponsavel  Microarea[]                     @relation("ACSMicroarea")
  filaAtendimentos       FilaAtendimento[]               @relation("ProfissionalFilaAtendimentos")
  escutasIniciais        EscutaInicial[]                 @relation("ProfissionalEscutasIniciais")
  encaminhamentosEscuta  EscutaInicial[]                 @relation("EncaminhamentosEscutaInicial")
  triagens               TriagemEnfermagem[]             @relation("EnfermeiroTriagens")
  encaminhamentosTriagem TriagemEnfermagem[]             @relation("EncaminhamentosTriagem")
  atividadesColetivas    ProfissionalAtividade[]         @relation("ProfissionalAtividades")
  configuracaoAgenda     ConfiguracaoAgenda[]            @relation("ProfissionalAgendas")
  indisponibilidades     IndisponibilidadeProfissional[] @relation("ProfissionalIndisponibilidades")

  // ✅ SISTEMA UNIFICADO DE VINCULAÇÃO V2.0
  assignments          EmployeeAssignment[]              @relation("ServidorVinculos")
  subordinados         EmployeeHierarchy[]               @relation("Subordinados")
  supervisores         EmployeeHierarchy[]               @relation("Supervisores")
  unidadesResponsavel  OrganizationalUnit[]              @relation("ResponsavelUnidade")
  equipesCoordena      Team[]                            @relation("CoordenadorEquipe")
  equipesParticipa     TeamMember[]                      @relation("MembroEquipes")
  healthData           HealthProfessionalData?           @relation("UserHealthData")
  educationData        EducationProfessionalData?        @relation("UserEducationData")
  engineeringData      EngineeringProfessionalData?      @relation("UserEngineeringData")
  socialAssistanceData SocialAssistanceProfessionalData? @relation("UserSocialAssistanceData")

  // ✅ NOVO: Sistema de Atribuição de Protocolos (Sistema Unificado V2.0)
  protocolAssignments ProtocolServerAssignment[] @relation("UserProtocolAssignments")
  protocolsAssignedBy ProtocolServerAssignment[] @relation("ProtocolAssignedBy")
  currentProtocols    ProtocolSimplified[]       @relation("CurrentProtocolAssignment")

  // ✅ Apps Saúde - Relacionamentos que migraram de ProfissionalSaude
  atendimentosOdonto       AtendimentoOdontologico[] @relation("DentistaAtendimentos")
  visitasDomiciliares      VisitaDomiciliar[]        @relation("ACSVisitas")
  indisponibilidadesAgenda IndisponibilidadeAgenda[]
  imunizacoes              ImunizacaoCidadao[]

  // ✅ NOVO: Preferências do usuário (2026-02-05)
  preferences    UserPreferences? @relation("UserPreferences")
  activeSessions UserSession[]    @relation("UserSessions")

  // ✅ NOVO: Sistema de Notificações Completo (2026-02-06)
  notifications           Notification[]          @relation("UserNotifications")
  pushSubscriptions       PushSubscription[]      @relation("UserPushSubscriptions")
  notificationPreferences NotificationPreference? @relation("UserNotificationPreferences")

  @@map("users")
}

// ✅ NOVA TABELA: Relacionamento N:N User ↔ Department
model UserDepartment {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  isPrimary    Boolean  @default(false) // Departamento principal
  isActive     Boolean  @default(true) // Pode desativar específico
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relacionamentos
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@index([userId, isPrimary])
  @@map("user_departments")
}

// ============================================
// PREFERÊNCIAS E SESSÕES DO USUÁRIO (2026-02-05)
// ============================================

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserPreferences", fields: [userId], references: [id], onDelete: Cascade)

  // Aparência
  theme        String  @default("system") // light, dark, system
  primaryColor String? // Cor primária personalizada (hex)
  compactMode  Boolean @default(false) // UI compacta
  fontSize     String  @default("medium") // small, medium, large
  highContrast Boolean @default(false)
  reduceMotion Boolean @default(false)

  // Avatar
  avatarUrl String? // URL da foto de perfil

  // Notificações - Canais
  emailNotifications   Boolean @default(true)
  browserNotifications Boolean @default(true)
  soundEnabled         Boolean @default(true)

  // Notificações - Tipos específicos
  notifyNewProtocol    Boolean @default(true)
  notifyProtocolUpdate Boolean @default(true)
  notifyNewCitizen     Boolean @default(false)
  notifySystemUpdates  Boolean @default(true)
  notifyAssignment     Boolean @default(true)
  notifyOverdueSLA     Boolean @default(true)
  notifyMessages       Boolean @default(true)
  notifyDocuments      Boolean @default(true)

  // Horário de silêncio (formato HH:mm)
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String? // Ex: "22:00"
  quietHoursEnd     String? // Ex: "07:00"

  // Preferências de visualização
  defaultProtocolView   String  @default("table") // table, grid, kanban
  protocolsPerPage      Int     @default(20)
  showArchivedByDefault Boolean @default(false)

  // Dashboard
  dashboardLayout Json? // Layout personalizado de widgets

  // Localização
  timezone   String @default("America/Sao_Paulo")
  language   String @default("pt-BR")
  dateFormat String @default("DD/MM/YYYY")
  timeFormat String @default("24h") // 12h, 24h

  // Privacidade
  showOnlineStatus    Boolean @default(true)
  allowAnalytics      Boolean @default(true)
  showActivityHistory Boolean @default(true)

  // Avançado
  developerMode Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model UserSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  token     String  @unique
  ipAddress String?
  userAgent String?
  device    String? // desktop, mobile, tablet
  browser   String? // chrome, firefox, safari, etc
  os        String? // windows, macos, linux, android, ios
  location  String? // cidade/estado (via IP)

  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  expiresAt    DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([userId, isActive])
  @@map("user_sessions")
}

// ✅ NOVO: Dados específicos de saúde vinculados ao servidor (User)
// Substitui o modelo ProfissionalSaude duplicado
model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  protocolsSimplified ProtocolSimplified[]
  servicesSimplified  ServiceSimplified[]
  users               User[]               @relation("UserPrimaryDepartment")

  // ✅ NOVO: Múltiplos usuários (N:N)
  userDepartments UserDepartment[]

  // Chamados administrativos
  tickets AdminTicket[]

  // ✅ SISTEMA UNIFICADO DE VINCULAÇÃO V2.0
  organizationalUnits OrganizationalUnit[] @relation("DepartmentOrganizationalUnits")
  positions           Position[]           @relation("DepartmentPositions")
  functions           Function[]           @relation("DepartmentFunctions")
  assignments         EmployeeAssignment[] @relation("DepartmentAssignments")
  teams               Team[]               @relation("DepartmentTeams")

  @@map("departments")
}

model Citizen {
  id                  String             @id @default(cuid())
  cpf                 String
  name                String
  email               String
  phone               String?
  birthDate           DateTime?
  address             Json?
  municipioId         String?
  isActive            Boolean            @default(true)
  password            String
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  verifiedBy          String?
  verificationNotes   String?
  registrationSource  String             @default("SELF")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lastLogin           DateTime?

  // Campos adicionais para perfil completo do cidadão (endereço já está em address JSON)
  rg             String?
  phoneSecondary String?
  motherName     String?
  maritalStatus  String?
  occupation     String?
  familyIncome   String?

  // Avatar/Foto de perfil
  avatar              String? // URL da foto ou null para usar iniciais+cor
  auditLogs           AuditLog[]
  transferRequests    CitizenTransferRequest[]
  familyAsMember      FamilyComposition[]      @relation("FamilyMember")
  familyAsHead        FamilyComposition[]      @relation("FamilyHead")
  familyInvites       FamilyInvite[]           @relation("FamilyInvites")
  notifications       Notification[]
  protocolsSimplified ProtocolSimplified[]
  documents           CitizenDocument[]        @relation("CitizenDocuments")
  linkedProtocols     ProtocolCitizenLink[]    @relation("LinkedCitizens")
  tickets             AdminTicket[]

  // Recuperação de senha
  passwordResetTokens PasswordResetToken[]

  // Categorias do cidadão
  categories              CitizenCategoryAssignment[]      @relation("CitizenCategories")
  categoryProtocolHistory CitizenCategoryProtocolHistory[] @relation("CitizenCategoryProtocolHistory")
  categoryAuditLog        CitizenCategoryAuditLog[]        @relation("CitizenCategoryAuditLog")

  // Bot e conversações
  botConversations       BotConversation[]
  proactiveNotifications ProactiveNotification[]
  botUploads             BotUpload[]
  flowExecutions         FlowExecution[]

  // Certificados digitais
  digitalCertificates DigitalCertificate[] @relation("CitizenCertificates")

  // Documentos externos para assinatura
  externalDocuments ExternalDocument[] @relation("CitizenExternalDocuments")

  // Apps Saúde
  alergias         AlergiasCidadao[]     @relation("CitizenAllergies")
  comorbidades     ComorbidadesCidadao[] @relation("CitizenComorbidities")
  anexosProntuario AnexoProntuario[]     @relation("CitizenMedicalAttachments")
  imunizacoes      ImunizacaoCidadao[]   @relation("CitizenImmunizations")
  passageirosTFD   PassageiroViagemTFD[] @relation("CitizenTFDPassengers")

  // ✅ NOVOS: Alinhamento com PEC e-SUS
  problemasCondicoes      ProblemaCondicao[]      @relation("CitizenProblems")
  alergiasReacoes         AlergiaReacao[]         @relation("CitizenAllergiesReactions")
  preNatal                AcompanhamentoPreNatal? @relation("CitizenPreNatal")
  visitasDomiciliares     VisitaDomiciliar[]      @relation("CitizenHomeVisits")
  participacoesAtividades ParticipanteAtividade[] @relation("CitizenActivityParticipations")

  // ✅ FLUXO DE ATENDIMENTO PEC e-SUS
  equipeId         String?
  equipe           EquipeSaude?      @relation("CitizenEquipe", fields: [equipeId], references: [id])
  microareaId      String?
  microarea        Microarea?        @relation("CitizenMicroarea", fields: [microareaId], references: [id])
  filaAtendimentos FilaAtendimento[] @relation("CitizenFilaAtendimentos")

  // ✅ NOVO: Sistema de Notificações Completo (2026-02-06)
  pushSubscriptions       PushSubscription[]      @relation("CitizenPushSubscriptions")
  notificationPreferences NotificationPreference? @relation("CitizenNotificationPreferences")

  @@unique([cpf])
  @@index([equipeId])
  @@index([microareaId])
  @@map("citizens")
}

// ========================================
// RECUPERAÇÃO DE SENHA
// ========================================

model PasswordResetToken {
  id    String @id @default(cuid())
  token String @unique

  // Suporte para ambos tipos de usuário
  userId    String?
  citizenId String?

  userType String // "admin" ou "citizen"
  email    String

  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  citizen Citizen? @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@index([userId])
  @@index([citizenId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ========================================
// DOCUMENTOS PESSOAIS DO CIDADÃO
// ========================================

model CitizenDocument {
  id              String         @id @default(cuid())
  citizenId       String
  documentType    String // RG, CPF, Comprovante de Residência, Protocolo, etc.
  fileName        String
  filePath        String
  fileUrl         String? // URL para acesso direto (opcional)
  fileSize        Int
  mimeType        String
  status          DocumentStatus @default(PENDING)
  notes           String? // Observações de análise/rejeição
  uploadedAt      DateTime       @default(now())
  reviewedBy      String? // ID do admin que revisou
  reviewedAt      DateTime? // Data da revisão
  rejectionReason String? // Motivo da rejeição

  // Campos para documentos vindos de protocolos
  sourceType       String? // 'PROTOCOL', 'UPLOAD', null (legado)
  sourceDocumentId String? // ID do GeneratedDocument se vier de protocolo
  isVerified       Boolean   @default(false) // Documentos de protocolo são pré-verificados
  verifiedAt       DateTime?
  verifiedBy       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citizen Citizen @relation("CitizenDocuments", fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId])
  @@index([status])
  @@index([sourceType])
  @@index([sourceDocumentId])
  @@map("citizen_documents")
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  amount      Float
  plan        Plan
  period      String
  status      InvoiceStatus @default(PENDING)
  dueDate     DateTime
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  description String?
  paymentUrl  String?
  metadata    Json?

  @@map("invoices")
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  position  String?
  source    LeadSource
  status    String     @default("NEW")
  message   String?
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("leads")
}

model FamilyComposition {
  id           String             @id @default(cuid())
  headId       String
  memberId     String
  relationship FamilyRelationship
  isDependent  Boolean            @default(false)
  status       FamilyLinkStatus   @default(PENDING)

  // Campos calculados adicionados na Sprint 2
  monthlyIncome Decimal? // Renda mensal do membro
  occupation    String? // Ocupação
  education     String? // Escolaridade
  hasDisability Boolean? // Possui deficiência

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Citizen  @relation("FamilyMember", fields: [memberId], references: [id], onDelete: Cascade)
  head      Citizen  @relation("FamilyHead", fields: [headId], references: [id], onDelete: Cascade)

  @@unique([headId, memberId])
  @@index([status])
  @@map("family_compositions")
}

model FamilyInvite {
  id           String             @id @default(cuid())
  headId       String // Quem está convidando
  email        String // Email do convidado
  cpf          String? // CPF (opcional)
  phone        String? // Telefone (opcional)
  name         String? // Nome do convidado
  relationship FamilyRelationship // Relacionamento proposto
  isDependent  Boolean            @default(false)
  status       InviteStatus       @default(PENDING)
  token        String             @unique
  expiresAt    DateTime

  // Mensagem personalizada (opcional)
  message String?

  // Campos adicionais opcionais
  monthlyIncome Decimal?
  occupation    String?
  education     String?
  hasDisability Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  head      Citizen  @relation("FamilyInvites", fields: [headId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("family_invites")
}

// ========================================
// VINCULAÇÃO DE CIDADÃOS EM PROTOCOLOS
// ========================================

model ProtocolCitizenLink {
  id         String @id @default(cuid())
  protocolId String

  // Vínculo com cidadão cadastrado
  linkedCitizenId String
  linkedCitizen   Citizen @relation("LinkedCitizens", fields: [linkedCitizenId], references: [id], onDelete: Cascade)

  // Tipo de vínculo no contexto do protocolo
  linkType CitizenLinkType

  // Relacionamento com o solicitante (alinha com FamilyComposition)
  relationship String? // SON, SPOUSE, PARENT, OTHER (opcional se já existe em FamilyComposition)

  // Papel no serviço
  role ServiceRole

  // Dados contextuais específicos do vínculo (série escolar, escola, etc)
  contextData Json?

  // Campos de validação
  isVerified Boolean   @default(false) // Se o vínculo foi verificado contra FamilyComposition
  verifiedAt DateTime?
  verifiedBy String? // userId do admin que verificou

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocol ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@index([protocolId])
  @@index([linkedCitizenId])
  @@index([linkType])
  @@index([protocolId, linkType])
  @@index([linkedCitizenId, isVerified])
  @@index([protocolId, isVerified])
  @@index([isVerified, verifiedAt])
  @@map("protocol_citizen_links")
}

// ========================================
// SISTEMA SIMPLIFICADO DE PROTOCOLOS
// ========================================

model ServiceSimplified {
  id           String  @id @default(cuid())
  name         String
  description  String?
  departmentId String

  // SIMPLIFICAÇÃO: 1 enum ao invés de 8 flags
  serviceType ServiceType

  // 🆕 NOVO: Subtipo para classificação adicional (visual/funcional)
  serviceSubtype String? // "CAPTURA_COMPLETA", "SOLICITACAO_SIMPLES", "PAGAMENTO", "CONSULTIVO"

  // Para serviços COM_DADOS
  moduleType           String? @unique // "ATENDIMENTOS_SAUDE", "MATRICULA_ALUNO", etc - DEVE SER ÚNICO
  formSchema           Json? // Schema do formulário
  linkedCitizensConfig Json? // Configuração de vinculação de cidadãos (alunos, dependentes, etc)

  // Configuração de campos do formulário
  formFieldsConfig Json? // Array de objetos {id, label, type, required, enabled, category}
  enabledFields    Json? // Array de IDs dos campos habilitados (fallback)

  // Campos básicos
  isActive          Boolean @default(true)
  requiresDocuments Boolean @default(false)
  requiredDocuments Json?
  estimatedDays     Int?
  priority          Int     @default(1)
  category          String?
  icon              String?
  color             String?

  // Configuração de geolocalização
  requiresSpecificLocation Boolean @default(false) // Se true, requer localização específica (não usa endereço do cidadão)
  locationLabel            String? // Label personalizado para o campo (ex: "Local do buraco", "Endereço da ocorrência")
  enableMapSelection       Boolean @default(false) // Permite marcar localização no mapa

  // ✅ NOVO: Sistema de validação de unicidade de protocolos
  allowMultipleActiveProtocols Boolean @default(true) // Permite múltiplos protocolos ativos do mesmo serviço por cidadão
  uniquenessScope              String? // 'CITIZEN' | 'CUSTOM' | 'CITIZEN_PER_FIELD'
  uniquenessRules              Json? // Regras JSON para validação (estrutura varia por scope)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department           @relation(fields: [departmentId], references: [id])
  protocols  ProtocolSimplified[]
  tickets    AdminTicket[]

  // ✅ NOVO: Workflow próprio do serviço
  workflow ServiceWorkflow?

  @@map("services_simplified")
}

model ProtocolSimplified {
  id          String         @id @default(cuid())
  number      String         @unique
  title       String
  description String?
  status      ProtocolStatus @default(VINCULADO)
  priority    Int            @default(3)

  // Relacionamentos principais
  citizenId    String
  serviceId    String
  departmentId String

  // Dados capturados (se COM_DADOS)
  customData Json?
  moduleType String? // Para roteamento

  // Geolocalização
  latitude          Float?
  longitude         Float?
  address           String?
  locationType      String? // 'CITIZEN_ADDRESS', 'SPECIFIC_LOCATION', 'MANUAL_PIN', 'GPS'
  geocodingProvider String? // 'nominatim', 'geoapify', 'manual'
  specificLocation  String? // Endereço específico informado (diferente do endereço do cidadão)

  // Gestão
  assignedUserId String?
  createdById    String?

  // ✅ FASE 1: Workflow tracking
  currentStageId String? // Stage atual em execução

  // ✅ NOVO: Sistema de Atribuição Avançado (Sistema Unificado V2.0)
  currentAssignedUserId String? // Servidor principal atual (denormalizado para performance)
  organizationalUnitId  String? // Unidade organizacional responsável
  teamId                String? // Equipe responsável (para protocolos de múltiplos servidores)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dueDate     DateTime?
  concludedAt DateTime?

  // Relacionamentos
  citizen      Citizen           @relation(fields: [citizenId], references: [id])
  service      ServiceSimplified @relation(fields: [serviceId], references: [id])
  department   Department        @relation(fields: [departmentId], references: [id])
  assignedUser User?             @relation("AssignedUserSimplified", fields: [assignedUserId], references: [id])
  createdBy    User?             @relation("CreatedByUserSimplified", fields: [createdById], references: [id])

  // ✅ NOVO: Relacionamentos com Sistema Unificado V2.0
  currentAssignedUser User?                      @relation("CurrentProtocolAssignment", fields: [currentAssignedUserId], references: [id])
  organizationalUnit  OrganizationalUnit?        @relation("ProtocolOrganizationalUnits", fields: [organizationalUnitId], references: [id])
  team                Team?                      @relation("ProtocolTeams", fields: [teamId], references: [id])
  serverAssignments   ProtocolServerAssignment[] @relation("ProtocolServerAssignments")

  // Relacionamentos núcleo do protocolo
  history                 ProtocolHistorySimplified[]
  evaluations             ProtocolEvaluationSimplified[]
  interactions            ProtocolInteraction[]
  documentFiles           ProtocolDocument[]
  dataFields              ProtocolDataField[]
  pendings                ProtocolPending[]
  stages                  ProtocolStage[]
  currentStage            ProtocolStage?                   @relation("CurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  sla                     ProtocolSLA?
  citizenLinks            ProtocolCitizenLink[]
  tfdSolicitacao          SolicitacaoTFD?                  @relation("TFDProtocol")
  ticket                  AdminTicket?
  generatedDocuments      GeneratedDocument[]
  generatedCategories     CitizenCategoryAssignment[]      @relation("ProtocolGeneratedCategories")
  categoryProtocolHistory CitizenCategoryProtocolHistory[] @relation("CategoryProtocolHistory")

  @@index([status])
  @@index([createdAt])
  @@index([moduleType, status])
  @@index([departmentId, status])
  @@index([citizenId])
  @@index([currentStageId])
  @@map("protocols_simplified")
}

model ProtocolHistorySimplified {
  id         String   @id @default(cuid())
  action     String
  comment    String?
  oldStatus  String?
  newStatus  String?
  metadata   Json?
  timestamp  DateTime @default(now())
  userId     String?
  protocolId String

  protocol ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@map("protocol_history_simplified")
}

model ProtocolEvaluationSimplified {
  id             String   @id @default(cuid())
  protocolId     String
  rating         Int
  comment        String?
  wouldRecommend Boolean  @default(true)
  createdAt      DateTime @default(now())

  protocol ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@map("protocol_evaluations_simplified")
}

// ========================================
// SISTEMA DE CHAMADOS ADMINISTRATIVOS
// ========================================

model AdminTicket {
  id     String @id @default(cuid())
  number String @unique // CH-2025-XXXXX

  // Dados da solicitação
  title       String
  description String
  priority    Int    @default(3)

  // Solicitante (prefeito/admin)
  requestedById String
  requestedBy   User   @relation("TicketRequester", fields: [requestedById], references: [id])

  // Alvo da solicitação
  citizenId    String
  citizen      Citizen           @relation(fields: [citizenId], references: [id])
  serviceId    String
  service      ServiceSimplified @relation(fields: [serviceId], references: [id])
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])

  // Estado do chamado
  status TicketStatus @default(PENDING)

  // Protocolo gerado (quando secretaria aceita)
  protocolId String?             @unique
  protocol   ProtocolSimplified? @relation(fields: [protocolId], references: [id])

  // Atribuição (quando secretaria aceita)
  assignedUserId String?
  assignedUser   User?   @relation("TicketAssigned", fields: [assignedUserId], references: [id])

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  protocolCreatedAt DateTime?

  // Observações e histórico
  observations    String?
  rejectionReason String?
  acceptedBy      String? // Nome do usuário que aceitou
  rejectedBy      String? // Nome do usuário que rejeitou

  @@index([status])
  @@index([departmentId, status])
  @@index([createdAt])
  @@index([requestedById])
  @@map("admin_tickets")
}

// ========================================
// SISTEMA DE INTERAÇÕES
// ========================================

model ProtocolInteraction {
  id         String          @id @default(cuid())
  protocolId String
  type       InteractionType

  // Autor
  authorType String // CITIZEN, SERVER, SYSTEM
  authorId   String?
  authorName String

  // Conteúdo
  message  String?
  metadata Json?

  // Visibilidade
  isInternal Boolean   @default(false)
  isRead     Boolean   @default(false)
  readAt     DateTime?

  // Anexos
  attachments Json?

  createdAt DateTime @default(now())

  protocol ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@index([protocolId, createdAt])
  @@index([protocolId])
  @@map("protocol_interactions")
}

enum InteractionType {
  MESSAGE
  DOCUMENT_REQUEST
  DOCUMENT_UPLOAD
  PENDING_CREATED
  PENDING_RESOLVED
  STATUS_CHANGED
  ASSIGNED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
  APPROVAL
  REJECTION
  CANCELLATION
  NOTE
  URGENCY_REQUEST
}

// ========================================
// SISTEMA DE DOCUMENTOS
// ========================================

model ProtocolDocument {
  id         String @id @default(cuid())
  protocolId String

  // Tipo de documento
  documentType String
  isRequired   Boolean

  // Status do documento
  status DocumentStatus @default(PENDING)

  // Arquivo
  fileName String?
  fileUrl  String?
  fileSize Int?
  mimeType String?

  // Validação
  uploadedAt      DateTime?
  uploadedBy      String?
  validatedAt     DateTime?
  validatedBy     String?
  rejectedAt      DateTime?
  rejectionReason String?

  // Versionamento
  version       Int     @default(1)
  previousDocId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocol ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@index([protocolId, documentType])
  @@index([protocolId])
  @@map("protocol_documents")
}

enum DocumentStatus {
  PENDING
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

// ========================================
// SISTEMA DE PENDÊNCIAS
// ========================================

model ProtocolPending {
  id         String @id @default(cuid())
  protocolId String

  // Tipo e descrição
  type        PendingType
  title       String
  description String

  // Prazo
  dueDate DateTime?

  // Status
  status     PendingStatus @default(OPEN)
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?

  // Bloqueio
  blocksProgress Boolean @default(true)

  // Metadados
  metadata Json?

  // Criação
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocol ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@index([protocolId, status])
  @@index([protocolId])
  @@map("protocol_pendings")
}

enum PendingType {
  DOCUMENT
  INFORMATION
  CORRECTION
  VALIDATION
  PAYMENT
  INSPECTION
  APPROVAL
  OTHER
}

enum PendingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  EXPIRED
  CANCELLED
}

// ========================================
// SISTEMA DE APROVAÇÃO DE CAMPOS DE DADOS
// ========================================

model ProtocolDataField {
  id         String @id @default(cuid())
  protocolId String

  // Identificação do campo
  fieldKey   String // Ex: "nome_propriedade", "area_hectares"
  fieldLabel String // Ex: "Nome da Propriedade", "Área (hectares)"
  fieldValue String // Valor armazenado como string

  // Classificação
  isRequired Boolean @default(false)
  fieldType  String? // "text", "number", "date", "cpf", etc

  // Status de aprovação
  status DataFieldStatus @default(PENDING)

  // Validação
  validatedBy     String?
  validatedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  // Histórico de versões
  version       Int     @default(1)
  previousValue String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocol ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  // Relações com auditoria
  approvals FieldApproval[] @relation("FieldApprovals")
  changes   FieldChange[]   @relation("FieldChanges")

  @@unique([protocolId, fieldKey]) // Apenas 1 registro por campo
  @@index([protocolId, status])
  @@index([status])
  @@map("protocol_data_fields")
}

enum DataFieldStatus {
  PENDING // Aguardando validação
  UNDER_REVIEW // Em análise
  APPROVED // Aprovado
  REJECTED // Rejeitado, precisa correção
  CORRECTED // Corrigido pelo cidadão, aguarda revalidação
}

// ========================================
// AUDITORIA DE CAMPOS (FieldApproval e FieldChange)
// ========================================

// Histórico de aprovações/rejeições de campos
model FieldApproval {
  id      String @id @default(cuid())
  fieldId String

  // Ação realizada
  action    String // "approve", "reject", "request_correction", "corrected"
  timestamp DateTime @default(now())

  // Responsável pela ação
  approvedBy     String // userId
  approvedByUser User   @relation("FieldApprovals", fields: [approvedBy], references: [id], onDelete: Cascade)

  // Detalhes
  reason String? // Motivo da rejeição ou comentário

  // Valores envolvidos
  previousValue String?
  newValue      String?

  field ProtocolDataField @relation("FieldApprovals", fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, timestamp])
  @@index([approvedBy, timestamp])
  @@map("field_approvals")
}

// Rastreamento de mudanças de campos
model FieldChange {
  id      String @id @default(cuid())
  fieldId String

  // Tipo de mudança
  changeType String // "value_changed", "status_changed", "version_increment"
  timestamp  DateTime @default(now())

  // Valores
  oldValue String?
  newValue String?

  // Responsável pela mudança
  actor     String // userId
  actorUser User   @relation("FieldChanges", fields: [actor], references: [id], onDelete: Cascade)

  field ProtocolDataField @relation("FieldChanges", fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, timestamp])
  @@index([actor, timestamp])
  @@map("field_changes")
}

// ========================================
// WORKFLOW ESPECÍFICO POR MÓDULO
// ========================================

