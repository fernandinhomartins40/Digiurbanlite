// ========================================
// SISTEMA DE ASSINATURA DIGITAL MUNICIPAL
// ========================================

enum CertificateType {
  SERVER // Servidores públicos municipais
  CITIZEN // Cidadãos
  SYSTEM // Sistemas/APIs
}

enum CertStatus {
  ACTIVE // Certificado ativo
  REVOKED // Certificado revogado
  EXPIRED // Certificado expirado
  SUSPENDED // Certificado suspenso temporariamente
}

enum RevocationReason {
  UNSPECIFIED // Não especificado
  KEY_COMPROMISE // Chave privada comprometida
  CA_COMPROMISE // Autoridade certificadora comprometida
  AFFILIATION_CHANGED // Mudança de lotação/desligamento
  SUPERSEDED // Substituído por novo certificado
  CESSATION // Cessação de operação
  CERTIFICATE_HOLD // Suspensão temporária
}

// Certificados Digitais
model DigitalCertificate {
  id              String          @id @default(cuid())
  userId          String? // FK para User (servidor) - opcional
  citizenId       String? // FK para Citizen (cidadão) - opcional
  certificateType CertificateType // Tipo de certificado

  // Informações do Certificado X.509
  serialNumber String  @unique // Número de série único
  commonName   String // Nome do titular (CN)
  email        String // Email do titular
  organization String  @default("Prefeitura Municipal") // O=
  department   String? // OU=

  // Chaves Criptográficas (RSA)
  publicKey           String @db.Text // Chave pública (formato PEM)
  privateKeyHash      String // Hash SHA-256 da chave privada (para validação)
  encryptedPrivateKey String @db.Text // Chave privada criptografada com AES-256-GCM
  keySize             Int    @default(2048) // Tamanho da chave em bits (2048, 3072, 4096)

  // Validade
  issuedAt         DateTime          @default(now())
  expiresAt        DateTime // Geralmente 1-2 anos
  revokedAt        DateTime?
  revocationReason RevocationReason?

  // Status
  status   CertStatus @default(ACTIVE)
  isActive Boolean    @default(true)

  // Metadados da CA
  issuerCA         String @default("CA-MUNICIPAL-001") // Identificador da CA emissora
  certificateChain String @db.Text // Cadeia completa de certificação (PEM)
  thumbprint       String // SHA-256 fingerprint do certificado

  // Auditoria
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  user       User?               @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  citizen    Citizen?            @relation("CitizenCertificates", fields: [citizenId], references: [id], onDelete: Cascade)
  signatures Signature[]
  request    CertificateRequest? @relation("RequestedCertificate")

  @@index([userId])
  @@index([citizenId])
  @@index([serialNumber])
  @@index([status])
  @@index([expiresAt])
  @@index([thumbprint])
  @@map("digital_certificates")
}

// Assinaturas Digitais em Documentos
model Signature {
  id                 String  @id @default(cuid())
  documentId         String? // FK para GeneratedDocument (opcional)
  externalDocumentId String? // FK para ExternalDocument (opcional)
  certificateId      String // FK para DigitalCertificate

  // Dados da Assinatura Criptográfica
  signatureValue String @db.Text // Assinatura RSA em base64
  signatureHash  String // SHA-256 do documento no momento da assinatura
  signatureAlgo  String @default("SHA256withRSA") // Algoritmo usado

  // Metadados da Assinatura
  signedAt       DateTime @default(now())
  ipAddress      String // IP do assinante
  userAgent      String? // User agent do navegador
  geolocation    Json? // Lat/Long opcional para auditoria
  visualPosition Json? // Posição da assinatura visual no PDF (page, x, y, width, height)

  // Validação
  isValid         Boolean   @default(true) // Flag de validade
  validatedAt     DateTime? // Última vez que foi validada
  validationCount Int       @default(0) // Quantas vezes foi validada

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  document         GeneratedDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  externalDocument ExternalDocument?  @relation(fields: [externalDocumentId], references: [id], onDelete: Cascade)
  certificate      DigitalCertificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([externalDocumentId])
  @@index([certificateId])
  @@index([signedAt])
  @@index([isValid])
  @@map("signatures")
}

// Lista de Revogação de Certificados (CRL - Certificate Revocation List)
model CertificateRevocationList {
  id            String           @id @default(cuid())
  serialNumber  String // Número de série do certificado revogado
  certificateId String? // FK opcional para DigitalCertificate
  reason        RevocationReason // Motivo da revogação
  revokedAt     DateTime         @default(now())
  revokedBy     String // userId de quem revogou
  publishedAt   DateTime         @default(now())

  // Metadados
  comments String? @db.Text // Comentários sobre a revogação

  // Relacionamentos
  revokedByUser User @relation("CRLRevokedBy", fields: [revokedBy], references: [id])

  @@index([serialNumber])
  @@index([revokedAt])
  @@index([publishedAt])
  @@map("certificate_revocation_list")
}

// Solicitações de Certificado Digital
model CertificateRequest {
  id     String @id @default(cuid())
  userId String // FK para User (solicitante)

  // Informações do Certificado Solicitado
  commonName      String // Nome do solicitante
  email           String // Email do solicitante
  certificateType CertificateType // Tipo de certificado solicitado
  keySize         Int             @default(2048) // Tamanho da chave

  // Status da Solicitação
  status        CertificateRequestStatus @default(PENDING)
  requestReason String                   @db.Text // Motivo/justificativa da solicitação
  requestedAt   DateTime                 @default(now())

  // Aprovação/Rejeição
  reviewedBy     String? // userId do aprovador (prefeito/secretário)
  reviewedAt     DateTime?
  reviewComments String?   @db.Text // Comentários do aprovador

  // Certificado Gerado (se aprovado)
  certificateId String? @unique // FK para DigitalCertificate

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  user        User                @relation("UserCertificateRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?               @relation("CertificateRequestReviewer", fields: [reviewedBy], references: [id])
  certificate DigitalCertificate? @relation("RequestedCertificate", fields: [certificateId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
  @@index([reviewedBy])
  @@map("certificate_requests")
}

enum CertificateRequestStatus {
  PENDING // Aguardando aprovação
  APPROVED // Aprovado - certificado emitido
  REJECTED // Rejeitado
  CANCELLED // Cancelado pelo solicitante
}

// ============================================
// SISTEMA DE BOT E CONVERSAÇÕES
// ============================================

// Conversação com o DigiBot
model BotConversation {
  id            String    @id @default(cuid())
  citizenId     String
  intent        String?
  confidence    Float?
  currentFlow   String? // Fluxo atual (AGENDAR_CONSULTA, SOLICITAR_SERVICO, etc)
  flowStep      Int       @default(0) // Passo atual do fluxo
  flowData      Json? // Dados coletados durante o fluxo
  isActive      Boolean   @default(true)
  closedAt      DateTime?
  rating        Int? // 1-5 estrelas
  ratingComment String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relacionamentos
  citizen  Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  messages BotMessage[]

  @@index([citizenId])
  @@index([currentFlow])
  @@index([isActive])
  @@index([createdAt])
  @@map("bot_conversations")
}

// Mensagens da conversa com o bot
model BotMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // 'user' | 'bot' | 'system'
  content        String   @db.Text
  messageType    String   @default("text") // 'text' | 'card' | 'form' | 'quick_reply' | 'interactive'
  metadata       Json? // Dados adicionais (cards, formulários, etc)
  intent         String? // Intent reconhecida (apenas para mensagens do usuário)
  confidence     Float? // Confiança do reconhecimento
  wasTransferred Boolean  @default(false) // Foi transferido para humano?
  createdAt      DateTime @default(now())

  // Relacionamentos
  conversation BotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([intent])
  @@index([createdAt])
  @@map("bot_messages")
}

// Analytics do Bot
model BotAnalytics {
  id              String   @id @default(cuid())
  date            DateTime @default(now()) @db.Date
  intent          String
  totalCount      Int      @default(0)
  successCount    Int      @default(0) // Resolvido sem transferência
  transferCount   Int      @default(0) // Transferido para humano
  avgConfidence   Float?
  avgResponseTime Float? // Tempo médio de resposta (ms)
  uniqueCitizens  Int      @default(0)

  @@unique([date, intent])
  @@index([date])
  @@index([intent])
  @@map("bot_analytics")
}

// Notificações proativas do sistema
model ProactiveNotification {
  id           String    @id @default(cuid())
  citizenId    String
  type         String // 'protocol_expiring' | 'protocol_approved' | 'appointment_reminder' | 'suggestion'
  title        String
  message      String    @db.Text
  metadata     Json? // Dados adicionais
  scheduledFor DateTime // Quando deve ser enviada
  sentAt       DateTime?
  isRead       Boolean   @default(false)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  // Relacionamentos
  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId])
  @@index([type])
  @@index([scheduledFor])
  @@index([sentAt])
  @@map("proactive_notifications")
}

// Uploads de arquivos durante conversas com o bot
model BotUpload {
  id             String    @id @default(cuid())
  citizenId      String
  conversationId String?
  fileName       String
  fileSize       Int
  mimeType       String
  fileUrl        String // URL do arquivo armazenado
  uploadedAt     DateTime  @default(now())
  expiresAt      DateTime? // Opcional: expiração do arquivo temporário

  // Relacionamentos
  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId])
  @@index([conversationId])
  @@index([uploadedAt])
  @@map("bot_uploads")
}

// ========================================
// SISTEMA DE FLUXOS PROGRAMADOS DO BOT
// ========================================

// Definições de fluxos conversacionais
model FlowDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  version     String   @default("1.0.0")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false) // Fluxo padrão do sistema
  municipioId String? // Fluxo customizado por município
  nodes       Json // Array de nodos do fluxo
  metadata    Json? // Tags, categorias, ícones, etc
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String? // ID do usuário que criou

  // Relacionamentos
  executions FlowExecution[]

  @@index([municipioId])
  @@index([isActive])
  @@index([isDefault])
  @@map("flow_definitions")
}

// Execuções de fluxos (estado de conversação)
model FlowExecution {
  id             String    @id @default(cuid())
  citizenId      String
  flowId         String
  conversationId String? // Vincula com UltraZend Messages
  currentNodeId  String // ID do nodo atual
  state          Json // Estado completo: dados coletados, variáveis, etc
  history        Json // Histórico de navegação (array de node IDs)
  status         String // ACTIVE, COMPLETED, CANCELLED, ERROR
  errorMessage   String?   @db.Text

  // ✅ NOVO: Campos de pausa (movidos de metadata para campos diretos)
  isPaused       Boolean   @default(false)
  pausedBy       String? // userId do servidor que pausou
  pausedAt       DateTime?
  pauseReason    String? // "citizen_request", "complex_case", "human_needed"
  resumedAt      DateTime?
  resumedBy      String? // userId do servidor que retomou

  // ✅ NOVO: Retry e metadados
  retryCount     Int       @default(0)
  metadata       Json? // Outros metadados (não relacionados a pausa)

  startedAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  // Relacionamentos
  citizen                Citizen         @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  flow                   FlowDefinition  @relation(fields: [flowId], references: [id], onDelete: Cascade)
  activeInConversation   Conversation?   @relation("ActiveFlowExecution")

  @@index([citizenId])
  @@index([flowId])
  @@index([conversationId])
  @@index([status])
  @@index([startedAt])
  @@map("flow_executions")
}

// ============================================
// DOCUMENTOS EXTERNOS PARA ASSINATURA
// ============================================

// Documentos externos enviados por usuários para assinatura digital
model ExternalDocument {
  id String @id @default(cuid())

  // Proprietário do documento
  userId    String? // Servidor/Admin que fez upload
  citizenId String? // Cidadão que fez upload

  // Informações do arquivo
  fileName     String
  filePath     String // Caminho no storage
  fileSize     Int // Tamanho em bytes
  mimeType     String @default("application/pdf")
  documentHash String // SHA-256 para verificação de integridade

  // Metadados
  description String?  @db.Text
  uploadedAt  DateTime @default(now())
  isActive    Boolean  @default(true)

  // Assinatura Digital
  isSigned Boolean @default(false) // Se o documento foi assinado digitalmente

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  user       User?       @relation("UserExternalDocuments", fields: [userId], references: [id], onDelete: Cascade)
  citizen    Citizen?    @relation("CitizenExternalDocuments", fields: [citizenId], references: [id], onDelete: Cascade)
  signatures Signature[]

  @@index([userId])
  @@index([citizenId])
  @@index([uploadedAt])
  @@index([isActive])
  @@map("external_documents")
}

