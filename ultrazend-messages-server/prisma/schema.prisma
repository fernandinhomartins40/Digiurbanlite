  // Codificação
  tipo      TipoClassificacao // CIAP2 ou CID10
  codigo    String // Ex: K86 (CIAP2), I10 (CID10)
  descricao String // Descrição do problema

  // Status
  status        StatusProblema // ATIVO, LATENTE, RESOLVIDO
  dataInicio    DateTime
  dataResolucao DateTime?

  // Classificação
  gravidade  GravidadeProblema? // LEVE, MODERADO, GRAVE
  prioridade Int                @default(0) // 0-10

  // Vínculo com consultas
  consultaOrigemId    String? // Consulta onde foi identificado
  consultaResolucaoId String? // Consulta onde foi resolvido
  consultas           ConsultaMedica[] // Consultas que trataram este problema

  // Observações
  observacoes String? @db.Text

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Profissional que registrou

  // Relacionamento
  citizen Citizen @relation("CitizenProblems", fields: [citizenId], references: [id])

  @@index([citizenId, status])
  @@index([codigo])
  @@index([tipo])
  @@map("problemas_condicoes")
}

