# Database
DATABASE_URL="postgresql://digiurban:digiurban@localhost:5432/digiurban"

# Server
NODE_ENV=development
PORT=9001
HOST=0.0.0.0

# Redis (para Socket.io Adapter e Cache)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Messages Service
MESSAGES_SERVICE_TOKEN=ultrazend-messages-service-token-change-in-production
MESSAGE_SERVER_ID=default-message-server-id

# Upload/Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,audio/mpeg,audio/ogg

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MESSAGE_RATE_LIMIT_PER_MINUTE=30

# External Integrations (optional)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_BOT_TOKEN=
SMS_PROVIDER=
SMS_API_KEY=

# Logging
LOG_LEVEL=info
