{
  "name": "solicitar_servico",
  "description": "Fluxo completo para solicitar um serviço municipal por secretaria",
  "version": "2.0.0",
  "metadata": {
    "icon": "📝",
    "color": "#2196F3",
    "category": "service"
  },
  "nodes": [
    {
      "id": "start",
      "type": "message",
      "config": {
        "text": "📝 **Solicitar Serviço**\n\nVou te ajudar a solicitar um serviço da prefeitura.\n\nPrimeiro, selecione a secretaria responsável pelo serviço que você precisa."
      },
      "transitions": [
        { "to": "load_departments" }
      ]
    },
    {
      "id": "load_departments",
      "type": "action",
      "config": {
        "action": "getDepartments",
        "saveResultAs": "departmentsData"
      },
      "transitions": [
        { "to": "check_departments" }
      ]
    },
    {
      "id": "check_departments",
      "type": "condition",
      "config": {
        "conditions": [
          {
            "field": "departmentsData.count",
            "operator": "gt",
            "value": 0,
            "goto": "select_department"
          }
        ],
        "defaultGoto": "no_departments"
      }
    },
    {
      "id": "no_departments",
      "type": "message",
      "config": {
        "text": "😕 Não há secretarias com serviços disponíveis no momento.\n\nTente novamente mais tarde."
      },
      "transitions": [
        { "to": "end" }
      ]
    },
    {
      "id": "select_department",
      "type": "menu",
      "config": {
        "text": "🏢 **Selecione a Secretaria:**\n\nEscolha o departamento que oferece o serviço que você precisa:",
        "options": "{{departmentsData.departments}}",
        "saveAs": "selectedDept"
      },
      "transitions": [
        { "to": "load_dept_services" }
      ]
    },
    {
      "id": "load_dept_services",
      "type": "action",
      "config": {
        "action": "getServicesByDepartment",
        "params": {
          "departmentId": "{{selectedDept}}"
        },
        "saveResultAs": "deptServicesData"
      },
      "transitions": [
        { "to": "check_dept_services" }
      ]
    },
    {
      "id": "check_dept_services",
      "type": "condition",
      "config": {
        "conditions": [
          {
            "field": "deptServicesData.count",
            "operator": "gt",
            "value": 0,
            "goto": "show_dept_catalog"
          }
        ],
        "defaultGoto": "no_dept_services"
      }
    },
    {
      "id": "no_dept_services",
      "type": "message",
      "config": {
        "text": "📭 Esta secretaria não possui serviços disponíveis no momento.\n\nSelecione outra secretaria."
      },
      "transitions": [
        { "to": "select_department" }
      ]
    },
    {
      "id": "show_dept_catalog",
      "type": "message",
      "config": {
        "text": "{{deptServicesData.catalogText}}"
      },
      "transitions": [
        { "to": "select_service_from_dept" }
      ]
    },
    {
      "id": "select_service_from_dept",
      "type": "menu",
      "config": {
        "text": "📋 Selecione o serviço desejado:",
        "options": "{{deptServicesData.services}}",
        "saveAs": "selectedServiceId"
      },
      "transitions": [
        { "to": "load_form_schema" }
      ]
    },
    {
      "id": "load_form_schema",
      "type": "action",
      "config": {
        "action": "processFormSchema",
        "params": {
          "serviceId": "{{selectedServiceId}}"
        },
        "saveResultAs": "formSchemaData"
      },
      "transitions": [
        { "to": "show_service_details" }
      ]
    },
    {
      "id": "show_service_details",
      "type": "message",
      "config": {
        "text": "📋 **{{formSchemaData.service.name}}**\n\n{{formSchemaData.service.description}}\n\n⏱️ **Prazo estimado:** {{formSchemaData.service.estimatedDays}} dias úteis\n🏢 **Secretaria:** {{formSchemaData.service.department.name}}"
      },
      "transitions": [
        { "to": "confirm_service" }
      ]
    },
    {
      "id": "confirm_service",
      "type": "menu",
      "config": {
        "text": "Deseja solicitar este serviço?",
        "options": [
          {
            "id": "sim",
            "label": "✅ Sim, prosseguir",
            "description": "Continuar com a solicitação"
          },
          {
            "id": "outro_servico",
            "label": "🔍 Escolher outro serviço",
            "description": "Voltar à lista de serviços"
          },
          {
            "id": "outra_secretaria",
            "label": "🏢 Outra secretaria",
            "description": "Voltar à seleção de secretaria"
          },
          {
            "id": "cancelar",
            "label": "❌ Cancelar",
            "description": "Voltar ao menu principal"
          }
        ]
      },
      "transitions": [
        { "when": "sim", "to": "check_has_form" },
        { "when": "outro_servico", "to": "select_service_from_dept" },
        { "when": "outra_secretaria", "to": "select_department" },
        { "when": "cancelar", "to": "end" }
      ]
    },
    {
      "id": "check_has_form",
      "type": "condition",
      "config": {
        "conditions": [
          {
            "field": "formSchemaData.hasForm",
            "operator": "eq",
            "value": true,
            "goto": "fill_form"
          }
        ],
        "defaultGoto": "ask_description"
      }
    },
    {
      "id": "fill_form",
      "type": "form",
      "config": {
        "text": "📝 **Preencha os dados necessários:**\n\nOs campos marcados com * são obrigatórios.",
        "fields": "{{formSchemaData.questions}}",
        "dynamicFields": true,
        "saveAs": "collectedFormData"
      },
      "transitions": [
        { "to": "check_needs_documents" }
      ]
    },
    {
      "id": "ask_description",
      "type": "question",
      "config": {
        "text": "📝 Descreva sua solicitação:\n\n(Explique detalhadamente o que você precisa)",
        "validation": {
          "type": "text",
          "minLength": 10,
          "maxLength": 1000,
          "errorMessage": "A descrição deve ter entre 10 e 1000 caracteres"
        },
        "saveAs": "description"
      },
      "transitions": [
        { "to": "check_needs_documents" }
      ]
    },
    {
      "id": "check_needs_documents",
      "type": "condition",
      "config": {
        "conditions": [
          {
            "field": "formSchemaData.requiresDocuments",
            "operator": "eq",
            "value": true,
            "goto": "show_required_docs"
          }
        ],
        "defaultGoto": "format_review"
      }
    },
    {
      "id": "show_required_docs",
      "type": "message",
      "config": {
        "text": "📎 **Documentos necessários:**\n\nEste serviço requer documentos. Você pode enviar agora ou adicionar depois pelo painel web."
      },
      "transitions": [
        { "to": "upload_documents" }
      ]
    },
    {
      "id": "upload_documents",
      "type": "upload",
      "config": {
        "text": "📤 Envie os documentos (opcional):\n\nVocê pode enviar até 5 arquivos.\nFormatos aceitos: PDF, imagens, documentos Office.\n\n💡 Se preferir, envie \"pular\" para continuar sem documentos.",
        "multiple": true,
        "maxFiles": 5,
        "maxFileSize": 10,
        "allowedTypes": ["application/pdf", "image/*", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"],
        "allowSkip": true,
        "saveAs": "uploadedDocuments"
      },
      "transitions": [
        { "to": "format_review" }
      ]
    },
    {
      "id": "format_review",
      "type": "action",
      "config": {
        "action": "formatProtocolReview",
        "params": {
          "serviceId": "{{selectedServiceId}}",
          "formData": "{{collectedFormData}}",
          "description": "{{description}}",
          "documents": "{{uploadedDocuments}}"
        },
        "saveResultAs": "reviewData"
      },
      "transitions": [
        { "to": "review_data" }
      ]
    },
    {
      "id": "review_data",
      "type": "message",
      "config": {
        "text": "{{reviewData.reviewText}}"
      },
      "transitions": [
        { "to": "confirm_submit" }
      ]
    },
    {
      "id": "confirm_submit",
      "type": "menu",
      "config": {
        "text": "Confirma o envio da solicitação?",
        "options": [
          {
            "id": "confirmar",
            "label": "✅ Confirmar e enviar",
            "description": "Criar protocolo"
          },
          {
            "id": "corrigir",
            "label": "✏️ Corrigir dados",
            "description": "Voltar ao formulário"
          },
          {
            "id": "cancelar",
            "label": "❌ Cancelar",
            "description": "Descartar solicitação"
          }
        ]
      },
      "transitions": [
        { "when": "confirmar", "to": "create_protocol" },
        { "when": "corrigir", "to": "check_has_form" },
        { "when": "cancelar", "to": "cancelled" }
      ]
    },
    {
      "id": "create_protocol",
      "type": "action",
      "config": {
        "action": "createProtocol",
        "params": {
          "serviceId": "{{selectedServiceId}}",
          "description": "{{description}}",
          "customData": "{{collectedFormData}}",
          "documents": "{{uploadedDocuments}}"
        },
        "saveResultAs": "createdProtocol"
      },
      "transitions": [
        { "to": "check_protocol_created" }
      ]
    },
    {
      "id": "check_protocol_created",
      "type": "condition",
      "config": {
        "conditions": [
          {
            "field": "createdProtocol.protocol",
            "operator": "exists",
            "goto": "success"
          }
        ],
        "defaultGoto": "creation_error"
      }
    },
    {
      "id": "creation_error",
      "type": "message",
      "config": {
        "text": "❌ **Não foi possível criar o protocolo.**\n\nOcorreu um erro ao processar sua solicitação. Por favor, tente novamente ou entre em contato com a prefeitura."
      },
      "transitions": [
        { "to": "ask_retry" }
      ]
    },
    {
      "id": "ask_retry",
      "type": "menu",
      "config": {
        "text": "O que deseja fazer?",
        "options": [
          {
            "id": "tentar",
            "label": "🔄 Tentar novamente",
            "description": "Reenviar solicitação"
          },
          {
            "id": "menu",
            "label": "🏠 Menu principal",
            "description": "Voltar ao início"
          }
        ]
      },
      "transitions": [
        { "when": "tentar", "to": "create_protocol" },
        { "when": "menu", "to": "end" }
      ]
    },
    {
      "id": "success",
      "type": "message",
      "config": {
        "text": "✅ **Protocolo criado com sucesso!**\n\n📋 **Número:** {{createdProtocol.protocol.number}}\n📅 **Data:** {{createdProtocol.protocol.createdAt}}\n🏢 **Secretaria:** {{createdProtocol.protocol.department.name}}\n⏱️ **Prazo estimado:** {{createdProtocol.protocol.service.estimatedDays}} dias úteis\n\nVocê pode acompanhar seu protocolo pelo menu **\"Consultar Protocolo\"**.\n\n📌 Guarde o número do seu protocolo para futuras consultas."
      },
      "transitions": [
        { "to": "ask_new_request" }
      ]
    },
    {
      "id": "ask_new_request",
      "type": "menu",
      "config": {
        "text": "O que você gostaria de fazer agora?",
        "options": [
          {
            "id": "nova",
            "label": "📝 Nova solicitação",
            "description": "Solicitar outro serviço"
          },
          {
            "id": "menu",
            "label": "🏠 Menu principal",
            "description": "Voltar ao início"
          }
        ]
      },
      "transitions": [
        { "when": "nova", "to": "select_department" },
        { "when": "menu", "to": "end" }
      ]
    },
    {
      "id": "cancelled",
      "type": "message",
      "config": {
        "text": "❌ Solicitação cancelada.\n\nVocê pode iniciar uma nova solicitação a qualquer momento pelo menu principal."
      },
      "transitions": [
        { "to": "end" }
      ]
    },
    {
      "id": "end",
      "type": "end",
      "config": {
        "message": "Voltando ao menu principal...",
        "returnToMain": true
      }
    }
  ]
}
