<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: 'Arial', sans-serif;
      font-size: 12pt;
      line-height: 1.6;
      color: #333;
      padding: 40px;
    }
    .header {
      text-align: center;
      border-bottom: 3px solid #0066cc;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }
    .header h1 {
      color: #0066cc;
      margin: 0;
      font-size: 24pt;
    }
    .header p {
      margin: 5px 0;
      font-size: 10pt;
      color: #666;
    }
    .info-box {
      background: #f5f5f5;
      padding: 15px;
      border-radius: 5px;
      margin: 20px 0;
    }
    .info-box h3 {
      margin: 0 0 10px 0;
      color: #0066cc;
      font-size: 14pt;
    }
    .info-row {
      display: flex;
      margin: 5px 0;
    }
    .info-label {
      font-weight: bold;
      min-width: 150px;
    }
    .exame-item {
      background: white;
      border: 2px solid #0066cc;
      border-radius: 5px;
      padding: 20px;
      margin: 15px 0;
      page-break-inside: avoid;
    }
    .exame-item .exame-nome {
      font-size: 16pt;
      font-weight: bold;
      color: #0066cc;
      margin-bottom: 10px;
    }
    .exame-item .prioridade {
      display: inline-block;
      padding: 5px 15px;
      border-radius: 20px;
      font-size: 11pt;
      font-weight: bold;
      margin-bottom: 10px;
    }
    .prioridade-emergencia {
      background: #ffebee;
      color: #c62828;
      border: 2px solid #c62828;
    }
    .prioridade-urgente {
      background: #fff3e0;
      color: #e65100;
      border: 2px solid #e65100;
    }
    .prioridade-rotina {
      background: #e8f5e9;
      color: #2e7d32;
      border: 2px solid #2e7d32;
    }
    .justificativa {
      background: #fff3cd;
      border-left: 4px solid #ffc107;
      padding: 10px;
      margin: 10px 0;
      font-style: italic;
    }
    .assinatura {
      margin-top: 60px;
      text-align: center;
    }
    .assinatura-linha {
      border-top: 2px solid #333;
      width: 300px;
      margin: 0 auto 10px;
    }
    .codigo-validacao {
      background: #e3f2fd;
      border: 2px solid #0066cc;
      padding: 15px;
      text-align: center;
      margin: 20px 0;
      font-size: 11pt;
    }
    .codigo-validacao .codigo {
      font-family: 'Courier New', monospace;
      font-size: 18pt;
      font-weight: bold;
      color: #0066cc;
      margin: 10px 0;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>🔬 SOLICITAÇÃO DE EXAMES</h1>
    <p>Requisição de Exames Laboratoriais e Complementares</p>
  </div>

  <div class="info-box">
    <h3>Dados do Paciente</h3>
    <div class="info-row">
      <span class="info-label">Nome:</span>
      <span>{{pacienteNome}}</span>
    </div>
    <div class="info-row">
      <span class="info-label">CPF:</span>
      <span>{{formatCPF pacienteCpf}}</span>
    </div>
    <div class="info-row">
      <span class="info-label">Data de Nascimento:</span>
      <span>{{formatDate pacienteDataNascimento}}</span>
    </div>
    {{#if pacienteEndereco}}
    <div class="info-row">
      <span class="info-label">Endereço:</span>
      <span>{{pacienteEndereco}}</span>
    </div>
    {{/if}}
    {{#if pacienteTelefone}}
    <div class="info-row">
      <span class="info-label">Telefone:</span>
      <span>{{formatPhone pacienteTelefone}}</span>
    </div>
    {{/if}}
  </div>

  <div class="info-box">
    <h3>Dados do Profissional Solicitante</h3>
    <div class="info-row">
      <span class="info-label">Nome:</span>
      <span>{{profissionalNome}}</span>
    </div>
    <div class="info-row">
      <span class="info-label">CRM:</span>
      <span>{{profissionalCrm}}</span>
    </div>
    {{#if profissionalEspecialidade}}
    <div class="info-row">
      <span class="info-label">Especialidade:</span>
      <span>{{profissionalEspecialidade}}</span>
    </div>
    {{/if}}
    <div class="info-row">
      <span class="info-label">Unidade de Saúde:</span>
      <span>{{unidadeSaude}}</span>
    </div>
    <div class="info-row">
      <span class="info-label">Data da Solicitação:</span>
      <span>{{formatDate dataSolicitacao}}</span>
    </div>
  </div>

  <h3 style="margin-top: 30px; color: #0066cc;">Exames Solicitados</h3>

  {{#each exames}}
  <div class="exame-item">
    <div class="exame-nome">{{this.nome}}</div>

    {{#if this.codigo}}
    <div style="color: #666; font-size: 11pt; margin-bottom: 10px;">
      <strong>Código:</strong> {{this.codigo}}
    </div>
    {{/if}}

    <div style="margin: 10px 0;">
      <span class="prioridade prioridade-{{this.prioridadeClass}}">
        {{this.prioridadeTexto}}
      </span>
    </div>

    {{#if this.justificativa}}
    <div class="justificativa">
      <strong>Justificativa Clínica:</strong><br>
      {{this.justificativa}}
    </div>
    {{/if}}

    {{#if this.observacoes}}
    <div style="margin-top: 10px; font-size: 11pt; color: #666;">
      <strong>Observações:</strong> {{this.observacoes}}
    </div>
    {{/if}}
  </div>
  {{/each}}

  {{#if hipoteseDiagnostica}}
  <div style="background: #e3f2fd; border: 2px solid #0066cc; padding: 15px; border-radius: 5px; margin: 20px 0;">
    <h4 style="margin: 0 0 10px 0; color: #0066cc;">Hipótese Diagnóstica</h4>
    <p style="margin: 0;">{{hipoteseDiagnostica}}</p>
    {{#if cid10}}
    <p style="margin: 10px 0 0 0; font-size: 11pt; color: #666;">
      <strong>CID-10:</strong> {{cid10}}
    </p>
    {{/if}}
  </div>
  {{/if}}

  {{#if observacoesGerais}}
  <div style="background: #f5f5f5; padding: 15px; border-radius: 5px; margin: 20px 0;">
    <strong>Observações Gerais:</strong><br>
    {{observacoesGerais}}
  </div>
  {{/if}}

  <div class="codigo-validacao">
    <div>🔐 <strong>Código de Validação</strong></div>
    <div class="codigo">{{validationCode}}</div>
    <div style="font-size: 9pt; color: #666;">
      Verifique a autenticidade deste documento em:<br>
      https://digiurban.com.br/validar-documento
    </div>
  </div>

  <div class="assinatura">
    <div class="assinatura-linha"></div>
    <div>
      <strong>{{profissionalNome}}</strong><br>
      {{profissionalCrm}}<br>
      {{#if profissionalEspecialidade}}{{profissionalEspecialidade}}<br>{{/if}}
      {{formatDate dataSolicitacao}}
    </div>
  </div>

  <div style="font-size: 9pt; color: #666; text-align: center; margin-top: 40px; border-top: 1px solid #e0e0e0; padding-top: 20px;">
    <p>Documento gerado eletronicamente pelo Sistema DigiUrban Saúde</p>
    <p>Este documento possui validade jurídica conforme MP 2.200-2/2001 e Lei 14.063/2020</p>
  </div>
</body>
</html>
