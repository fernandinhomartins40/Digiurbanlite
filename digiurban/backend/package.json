{
  "name": "digiurban-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "migrate:ts": "ts-migrate migrate src",
    "migrate:init": "ts-migrate init .",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:performance": "jest __tests__/performance --testTimeout=60000",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:regression": "node scripts/phase3/regression-tests.js",
    "test:phase3": "npm run test:regression",
    "test:phase4": "npm run test:integration && npm run test:performance && npm run audit:phase4",
    "audit:phase4": "tsx scripts/audit-phase4-final.ts",
    "validate:production": "npm run check && npm run test:regression",
    "validate:phase4": "npm run test:phase4",
    "prepare": "husky install",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed-consolidated.ts && tsx scripts/create-super-admin.ts",
    "db:seed:services-only": "tsx prisma/seeds/services/index.ts",
    "db:seed:document-templates": "tsx prisma/seeds/document-templates.seed.ts",
    "db:seed:workflow-document-templates": "tsx prisma/seeds/workflow-document-templates.seed.ts",
    "db:seed:legacy": "tsx prisma/seed.ts",
    "db:seed:superadmin": "tsx scripts/create-super-admin.ts",
    "db:seed:deploy-safe": "npm run db:seed:superadmin",
    "db:backfill:person-identity": "tsx prisma/seeds/backfill-person-identity.ts",
    "db:backfill:central-calendar": "tsx prisma/seeds/backfill-central-calendar.ts",
    "db:sync:secretarias-organograma": "tsx prisma/seeds/sync-departments-organogram.ts",
    "db:seed:saude": "tsx prisma/seeds/apps/saude/master-seed-saude.ts",
    "db:seed:rename": "tsx prisma/seeds/seed-rename-medicamentos.ts",
    "db:seed:full": "npm run db:seed && npm run db:seed:saude && npm run db:seed:rename",
    "db:rebuild:workflows": "tsx prisma/seeds/service-workflows.seed.ts && tsx src/scripts/migrate-protocol-stages-metadata.ts && tsx src/scripts/repair-workflow-utf8.ts",
    "db:repair:workflow-utf8": "tsx src/scripts/repair-workflow-utf8.ts",
    "db:validate:workflow-alignment": "tsx src/scripts/validate-service-workflows-alignment.ts",
    "db:validate:saude": "tsx scripts/validate-seeds-saude.ts",
    "db:validate:rename": "tsx scripts/validate-rename-implementation.ts",
    "populate-services": "tsx scripts/populate-services.ts",
    "email:health-check": "tsx src/scripts/run-email-server-health-check.ts",
    "diagnose": "tsx test-routes-loading.ts",
    "diagnose:server": "tsx test-server-start.ts",
    "diagnose:full": "npm run diagnose && npm run diagnose:server",
    "clean": "rm -rf dist node_modules/.cache",
    "clean:full": "rm -rf dist node_modules && npm install",
    "kill:node": "taskkill /F /IM node.exe /T || true"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "@types/handlebars": "^4.0.40",
    "@types/ioredis": "^4.28.10",
    "@types/joi": "^17.2.2",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "bullmq": "^5.67.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.3",
    "nodemailer": "^7.0.6",
    "openai": "^6.16.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "playwright": "^1.56.1",
    "redis": "^5.10.0",
    "sharp": "^0.34.5",
    "smtp-server": "^3.14.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "tesseract.js": "^6.0.1",
    "ua-parser-js": "^2.0.9",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "prisma": "~6.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.5.2",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^7.0.1",
    "@types/smtp-server": "^3.5.12",
    "@types/supertest": "^6.0.3",
    "@types/ua-parser-js": "^0.7.39",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-migrate": "^0.1.35",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "src/**/*.{json,md}": [
      "prettier --write",
      "git add"
    ]
  }
}
