# Environment
NODE_ENV=development

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Email
SUPPORT_EMAIL=suporte@digiurban.com.br

# Database
# ⚠️  IMPORTANTE: Sempre usar caminho relativo a partir de backend/
# Desenvolvimento: file:./prisma/dev.db
# Produção (Docker): file:/app/data/dev.db
DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Multi-tenant
DEFAULT_TENANT=demo

# --- Multi-tenant Fase 4/D ---
# Identidade do tenant default (município migrado do modo single-tenant)
# DEFAULT_TENANT_ID=tenant-default
# Domínio base dos subdomínios {slug}.TENANT_BASE_DOMAIN
# TENANT_BASE_DOMAIN=digiurban.com.br
# Hosts extras que resolvem para o tenant default (domínio do modo single-tenant)
# TENANT_DEFAULT_HOSTS=portal.municipio.gov.br,www.municipio.gov.br

# --- Cortes da Fase D (ligar APÓS a telemetria [TENANT-FAILSOFT] zerar) ---
# Operação Prisma/upload sem contexto de tenant LANÇA em vez de cair no default
# (recomendado: sempre 1 em dev/CI/staging)
# TENANT_STRICT=1
# Host desconhecido NÃO resolve para o default (responde TENANT_UNRESOLVED)
# TENANT_STRICT_HOST=1
# JWT sem claim de tenant (sessão antiga) é rejeitado com 401 (pede novo login)
# TENANT_REQUIRE_TOKEN_CLAIM=1

# CORS
CORS_ORIGIN=http://localhost:3000

# ============================================================
# DIGIBOT AI - Super App Features
# ============================================================

# Redis (para cache e gerenciamento de contexto do bot)
# OPCIONAL: Se não configurado, o bot usará armazenamento em memória
REDIS_URL="redis://localhost:6379"

# OpenAI (para processamento de linguagem natural do bot)
# OPCIONAL: Se não configurada, o bot usará Ollama ou reconhecimento de intents baseado em keywords
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Ollama (IA local para reconhecimento de intenções - RECOMENDADO)
# Ollama é uma solução gratuita e local que substitui OpenAI com melhor performance
# Para habilitar: USE_OLLAMA=true
# Para desabilitar: USE_OLLAMA=false
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=digibot-phi4
OLLAMA_TIMEOUT=5000

# WebSocket Server (para mensagens em tempo real)
WS_PORT=9001

# ============================================================
# SISTEMA DE NOTIFICAÇÕES COMPLETO (2026-02-06)
# ============================================================

# Push Notifications (Web Push API)
# Gere as chaves VAPID com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@digiurban.com.br"

# Email Notifications (usando Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# SMS Notifications (FUTURO - Twilio/AWS SNS)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
