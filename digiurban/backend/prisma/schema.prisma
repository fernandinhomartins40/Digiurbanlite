// ============================================================================

// MS-20+21: Gestão de Máquinas e Empréstimos

// ============================================================================
// ULTRAZEND MESSAGES - Sistema de Mensagens em Tempo Real
// ============================================================================

// ============================================
// ULTRAZEND MESSAGES - CORE
// ============================================

model MessageServer {
  id                String   @id @default(cuid())
  name              String   // "DigiUrban Messages"
  hostname          String   // messages.digiurban.com.br
  wsPort            Int      @default(9001)
  isActive          Boolean  @default(false)
  maxDailyMessages  Int      @default(100000)
  enableEncryption  Boolean  @default(false) // E2E encryption
  enableP2P         Boolean  @default(false) // Cidadão-Cidadão
  enableBroadcast   Boolean  @default(true)  // Canais oficiais
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relacionamentos
  conversations Conversation[]
  channels      OfficialChannel[]
  logs          MessageLog[]
  stats         MessageStats[]

  @@map("message_servers")
}

// ============================================
// CONVERSAS 1:1 E P2P
// ============================================

model Conversation {
  id              String             @id @default(cuid())
  messageServerId String

  // Participantes
  participant1Id   String
  participant1Type ParticipantType  // CITIZEN ou SERVER
  participant2Id   String
  participant2Type ParticipantType  // CITIZEN ou SERVER

  // Contexto (opcional - para vincular a protocolos)
  protocolId       String?
  departmentId     String?

  // Tipo de conversa
  type             ConversationType @default(SUPPORT) // SUPPORT, P2P, GROUP

  // Status
  status           ConversationStatus @default(ACTIVE)
  lastMessageAt    DateTime?
  lastMessagePreview String?         // Preview da última mensagem

  // Contadores
  totalMessages    Int      @default(0)
  unreadCount1     Int      @default(0) // Não lidas por participant1
  unreadCount2     Int      @default(0) // Não lidas por participant2

  // Metadados
  metadata         Json?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  closedAt         DateTime?

  // Bot-specific fields
  isBotConversation Boolean  @default(false)
  botFlowType       String?
  botFlowStep       Int      @default(0)
  botFlowData       Json?
  botContext        Json?
  botLastInteractionAt DateTime?

  // Relacionamentos
  messageServer MessageServer @relation(fields: [messageServerId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([participant1Id, participant1Type, participant2Id, participant2Type, protocolId])
  @@index([participant1Id, participant1Type, status])
  @@index([participant2Id, participant2Type, status])
  @@index([protocolId])
  @@index([status, lastMessageAt])
  @@index([isBotConversation, status])
  @@map("conversations")
}

enum ParticipantType {
  CITIZEN  // Cidadão
  SERVER   // Servidor público (User)
  SYSTEM   // Sistema automático
}

enum ConversationType {
  SUPPORT  // Suporte (cidadão <-> servidor)
  P2P      // Peer-to-peer (cidadão <-> cidadão)
  GROUP    // Grupo (futuro)
}

enum ConversationStatus {
  ACTIVE      // Conversa ativa
  ARCHIVED    // Arquivada pelo usuário
  CLOSED      // Encerrada oficialmente
  BLOCKED     // Bloqueada por violação
}

// ============================================
// MENSAGENS
// ============================================

model Message {
  id             String   @id @default(cuid())
  conversationId String

  // Autor
  senderId       String
  senderType     ParticipantType

  // Conteúdo
  content        String   @db.Text
  contentType    MessageContentType @default(TEXT)

  // Anexos
  attachments    Json?    // Array de {url, type, name, size}

  // Mensagem citada/respondida
  replyToId      String?

  // Status de entrega
  status         MessageStatus @default(SENT)
  sentAt         DateTime @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?

  // Edição/Exclusão
  isEdited       Boolean  @default(false)
  editedAt       DateTime?
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  deletedBy      String?  // ID de quem deletou

  // Metadados
  metadata       Json?    // IP, user-agent, location, etc

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relacionamentos
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  reports        MessageReport[]

  @@index([conversationId, sentAt])
  @@index([senderId, senderType])
  @@index([status, sentAt])
  @@index([isDeleted])
  @@map("messages")
}

enum MessageContentType {
  TEXT       // Texto simples
  IMAGE      // Imagem
  VIDEO      // Vídeo
  AUDIO      // Áudio
  DOCUMENT   // Documento (PDF, DOC, etc)
  LOCATION   // Localização geográfica
  STICKER    // Figurinha/Emoji
  SYSTEM     // Mensagem do sistema
}

enum MessageStatus {
  QUEUED     // Na fila para envio
  SENT       // Enviada
  DELIVERED  // Entregue
  READ       // Lida
  FAILED     // Falha no envio
}

// ============================================
// CANAIS OFICIAIS (BROADCAST)
// ============================================

model OfficialChannel {
  id              String   @id @default(cuid())
  messageServerId String

  // Informações
  name            String   // "Canal Oficial da Saúde"
  slug            String   @unique  // "saude-oficial"
  description     String?  @db.Text
  iconUrl         String?
  bannerUrl       String?
  color           String?  // Cor do canal (hex)

  // Vinculação
  departmentId    String?
  managedBy       Json     // Array de User IDs com permissão

  // Configurações
  isPublic        Boolean  @default(true)  // Qualquer um pode se inscrever?
  requiresApproval Boolean @default(false) // Inscrição precisa aprovação?
  isActive        Boolean  @default(true)
  allowComments   Boolean  @default(false) // Cidadãos podem comentar?

  // Estatísticas
  subscriberCount Int      @default(0)
  messageCount    Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacionamentos
  messageServer   MessageServer @relation(fields: [messageServerId], references: [id], onDelete: Cascade)
  subscriptions   ChannelSubscription[]
  messages        ChannelMessage[]

  @@index([isActive, isPublic])
  @@index([slug])
  @@map("official_channels")
}

model ChannelSubscription {
  id         String   @id @default(cuid())
  channelId  String
  citizenId  String

  // Status
  status     ChannelSubscriptionStatus @default(PENDING)
  subscribedAt DateTime @default(now())
  approvedAt   DateTime?
  approvedBy   String?  // User ID que aprovou

  // Preferências de Notificação
  notifyInApp   Boolean @default(true)
  notifyEmail   Boolean @default(false)
  notifySMS     Boolean @default(false)
  notifyPush    Boolean @default(true)

  // Metadados
  metadata      Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relacionamentos
  channel       OfficialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveries    ChannelDelivery[]

  @@unique([channelId, citizenId])
  @@index([citizenId, status])
  @@index([channelId, status])
  @@map("channel_subscriptions")
}

// SubscriptionStatus já definido no schema (usado por email)

model ChannelMessage {
  id         String   @id @default(cuid())
  channelId  String
  authorId   String   // User ID (servidor público)

  // Conteúdo
  title      String?
  content    String   @db.Text
  contentType MessageContentType @default(TEXT)

  // Mídia
  attachments Json?   // Array de {url, type, name, size}

  // Agendamento
  scheduledFor DateTime?
  publishedAt  DateTime?

  // Status
  status       BroadcastStatus @default(DRAFT)

  // Estatísticas
  deliveredCount Int @default(0)
  readCount      Int @default(0)
  failedCount    Int @default(0)

  // Prioridade
  priority       Int @default(3) // 1=urgent, 3=normal, 5=low

  // Metadados
  metadata       Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sentAt         DateTime?

  // Relacionamentos
  channel        OfficialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveries     ChannelDelivery[]

  @@index([channelId, publishedAt])
  @@index([status, scheduledFor])
  @@index([authorId])
  @@map("channel_messages")
}

enum BroadcastStatus {
  DRAFT      // Rascunho
  SCHEDULED  // Agendada
  SENDING    // Enviando
  SENT       // Enviada
  FAILED     // Falhou
  CANCELLED  // Cancelada
}

model ChannelDelivery {
  id        String   @id @default(cuid())
  messageId String
  subscriptionId String
  citizenId String

  // Status
  status    MessageStatus @default(QUEUED)
  queuedAt  DateTime @default(now())
  sentAt    DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  // Erro
  errorMessage String?
  retryCount   Int @default(0)

  // Metadados
  metadata     Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relacionamentos
  message      ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  subscription ChannelSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([messageId, citizenId])
  @@index([messageId, status])
  @@index([citizenId, status])
  @@index([status, queuedAt])
  @@map("channel_deliveries")
}

// ============================================
// PRIVACIDADE & MODERAÇÃO
// ============================================

model CitizenPrivacySettings {
  citizenId            String   @id

  // Quem pode enviar mensagens diretas?
  allowMessagesFromAll Boolean  @default(false)  // Qualquer cidadão
  allowMessagesFromServers Boolean @default(true) // Servidores públicos

  // Bloqueios
  blockedCitizens      Json     @default("[]")   // Array de citizen IDs
  blockedServers       Json     @default("[]")   // Array de user IDs

  // Notificações
  notifyNewMessage     Boolean  @default(true)
  notifySound          Boolean  @default(true)
  notifyVibrate        Boolean  @default(true)

  // Online Status
  showOnlineStatus     Boolean  @default(true)
  showLastSeen         Boolean  @default(true)
  showReadReceipts     Boolean  @default(true)

  // Backup
  autoBackup           Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("citizen_privacy_settings")
}

model MessageReport {
  id          String   @id @default(cuid())
  messageId   String
  reportedBy  String   // Citizen ID ou User ID
  reporterType ParticipantType

  // Motivo
  reason      ReportReason
  description String?  @db.Text

  // Status
  status      ReportStatus @default(PENDING)

  // Evidências
  screenshots Json?    // Array de URLs de screenshots

  // Revisão
  reviewedAt  DateTime?
  reviewedBy  String?  // User ID (moderador)
  reviewNotes String?  @db.Text
  action      ModerationAction?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([reportedBy, reporterType])
  @@index([status, createdAt])
  @@map("message_reports")
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  INAPPROPRIATE_CONTENT
  SCAM
  IMPERSONATION
  VIOLENCE
  OTHER
}

enum ReportStatus {
  PENDING     // Aguardando revisão
  REVIEWING   // Em análise
  RESOLVED    // Resolvida
  DISMISSED   // Descartada
  ESCALATED   // Escalada para autoridades
}

enum ModerationAction {
  NONE            // Nenhuma ação
  WARNING         // Aviso ao usuário
  MESSAGE_DELETED // Mensagem deletada
  USER_WARNED     // Usuário advertido
  USER_SUSPENDED  // Usuário suspenso temporariamente
  USER_BANNED     // Usuário banido permanentemente
  REPORTED_POLICE // Reportado às autoridades
}

// ============================================
// LOGS & AUDITORIA
// ============================================

model MessageLog {
  id              String   @id @default(cuid())
  messageServerId String?

  // Tipo de evento
  level           LogLevel @default(INFO)
  event           String   // message-sent, conversation-started, user-blocked, etc

  // Contexto
  userId          String?
  citizenId       String?
  conversationId  String?
  messageId       String?
  channelId       String?

  // Dados
  message         String   @db.Text
  data            Json?

  // Request info
  ipAddress       String?
  userAgent       String?

  timestamp       DateTime @default(now())

  // Relacionamentos
  messageServer   MessageServer? @relation(fields: [messageServerId], references: [id], onDelete: SetNull)

  @@index([messageServerId, timestamp])
  @@index([event, timestamp])
  @@index([level, timestamp])
  @@index([userId])
  @@index([citizenId])
  @@map("message_logs")
}

// LogLevel já definido no schema (usado por outros módulos)

model MessageStats {
  id              String   @id @default(cuid())
  messageServerId String

  // Data de referência
  date            DateTime @db.Date
  hour            Int?     // 0-23 (null = agregado do dia)

  // Métricas de mensagens
  totalMessages        Int @default(0)
  textMessages         Int @default(0)
  mediaMessages        Int @default(0)
  deletedMessages      Int @default(0)

  // Métricas de conversas
  totalConversations   Int @default(0)
  newConversations     Int @default(0)
  closedConversations  Int @default(0)

  // Métricas de usuários
  activeUsers          Int @default(0)  // Servidores ativos
  activeCitizens       Int @default(0)  // Cidadãos ativos
  onlineUsers          Int @default(0)  // Online agora

  // Métricas de canais
  channelMessages      Int @default(0)
  channelSubscriptions Int @default(0)
  channelDeliveries    Int @default(0)

  // Performance
  avgResponseTime      Float?  // Tempo médio de resposta (segundos)
  avgMessageLength     Float?  // Tamanho médio da mensagem

  // Moderação
  reportsCreated       Int @default(0)
  reportsResolved      Int @default(0)
  usersBlocked         Int @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relacionamentos
  messageServer        MessageServer @relation(fields: [messageServerId], references: [id], onDelete: Cascade)

  @@unique([messageServerId, date, hour])
  @@index([messageServerId, date])
  @@map("message_stats")
}

// ============================================
// SESSÕES WEBSOCKET (TRACKING)
// ============================================

model WebSocketSession {
  id          String   @id @default(cuid())
  socketId    String   @unique  // Socket.io socket.id

  // Usuário
  userId      String?
  userType    ParticipantType

  // Conexão
  ipAddress   String
  userAgent   String?
  connectedAt DateTime @default(now())
  lastPingAt  DateTime @default(now())

  // Status
  isOnline    Boolean  @default(true)

  // Metadados
  metadata    Json?

  disconnectedAt DateTime?

  @@index([userId, userType, isOnline])
  @@index([connectedAt])
  @@map("websocket_sessions")
}

// ============================================
// TEMPLATES DE MENSAGENS AUTOMÁTICAS
// ============================================

model MessageTemplate {
  id          String   @id @default(cuid())

  // Identificação
  name        String   @unique  // protocol-created, welcome-message, etc
  category    TemplateCategory

  // Conteúdo
  title       String?
  content     String   @db.Text
  contentType MessageContentType @default(TEXT)

  // Variáveis
  variables   Json     @default("[]")  // ["citizenName", "protocolNumber", etc]

  // Configuração
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false) // Template do sistema (não editável)

  // Metadados
  description String?
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("message_templates")
}

enum TemplateCategory {
  WELCOME          // Boas-vindas
  PROTOCOL         // Relacionado a protocolos
  NOTIFICATION     // Notificações gerais
  REMINDER         // Lembretes
  CONFIRMATION     // Confirmações
  ALERT            // Alertas
  SYSTEM           // Sistema
}

enum ChannelSubscriptionStatus {
  PENDING    // Aguardando aprovação
  ACTIVE     // Inscrito e recebendo
  MUTED      // Inscrito mas sem notificações
  BLOCKED    // Bloqueado de se inscrever
}

// ============================================================================
// SISTEMA DE GERAÇÃO DE DOCUMENTOS
// ============================================================================

model DocumentTemplate {
  id            String   @id @default(cuid())

  // Identificação
  name          String                      // Ex: "Certidão de Protocolo"
  code          String   @unique            // Ex: "CERTIDAO_PROTOCOLO"
  description   String?

  // Tipo de documento
  documentType  DocumentTemplateType        // PROTOCOL_CERTIFICATE, COMPLETION_REPORT, etc
  outputFormat  OutputFormat                // PDF, DOCX, HTML

  // Associação com serviços
  serviceIds    Json     @default("[]")     // Array de IDs de serviços
  isGlobal      Boolean  @default(false)    // Se true, disponível para todos os serviços

  // ✅ NOVO: Controle de quando o template pode ser usado no workflow
  allowedStageTypes Json?  @default("[]")   // Array de stageTypes permitidos (ex: ["CONCLUSION", "APPROVAL"])

  // Template Handlebars
  htmlTemplate  String   @db.Text           // HTML com variáveis {{protocolNumber}}, {{citizenName}}
  headerHtml    String?  @db.Text           // Cabeçalho (logo, brasão)
  footerHtml    String?  @db.Text           // Rodapé (assinaturas, carimbos)
  cssStyles     String?  @db.Text           // CSS para estilização

  // Variáveis disponíveis (documentação)
  availableVariables Json? @default("[]")   // Array de {name, description, example}

  // Configurações de geração
  pageSize      String   @default("A4")     // A4, Letter, Legal
  orientation   String   @default("portrait") // portrait, landscape
  margins       Json?                        // {top, right, bottom, left} em mm

  // Assinaturas/Carimbos
  requiresSignature Boolean @default(false)
  signatureFields   Json?   @default("[]")   // Array de {label, role, position}

  // Controle
  isActive      Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String

  // Relacionamentos
  generatedDocuments GeneratedDocument[]

  @@index([isActive])
  @@index([documentType])
  @@map("document_templates")
}

enum DocumentTemplateType {
  PROTOCOL_CERTIFICATE    // Certidão/comprovante de protocolo
  COMPLETION_REPORT       // Relatório de conclusão
  RECEIPT                 // Recibo de atendimento
  AUTHORIZATION           // Autorização/licença
  NOTIFICATION            // Notificação
  CUSTOM                  // Personalizado
}

enum OutputFormat {
  PDF
  DOCX
  HTML
}

model GeneratedDocument {
  id              String   @id @default(cuid())

  // Referências
  protocolId      String
  templateId      String

  // Arquivo gerado
  fileName        String
  filePath        String                    // /uploads/generated/{protocolId}/{timestamp}_{fileName}
  fileUrl         String?                   // URL pública (se configurado)
  fileSize        Int
  mimeType        String

  // Metadados
  generatedAt     DateTime @default(now())
  generatedBy     String                    // userId do admin
  templateVersion Int                       // Versão do template usada

  // Dados usados na geração (snapshot)
  variablesUsed   Json                      // Snapshot dos dados usados {protocolNumber, citizenName, etc}

  // Envio
  wasSent         Boolean  @default(false)
  sentAt          DateTime?
  sentBy          String?
  sentTo          String?                   // Email do destinatário

  // Controle
  isActive        Boolean  @default(true)   // Soft delete
  deletedAt       DateTime?

  // SISTEMA DE VALIDAÇÃO DE DOCUMENTOS
  validationCode  String?  @unique          // Código único de validação (VAL-YYYY-XXXXXX-CCCC)
  documentHash    String?                   // Hash SHA-256 do documento para verificação de integridade
  expiresAt       DateTime?                 // Data de expiração (opcional)
  validatedCount  Int      @default(0)      // Contador de validações públicas
  lastValidatedAt DateTime?                 // Última validação pública

  // Relacionamentos
  protocol        ProtocolSimplified @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  template        DocumentTemplate   @relation(fields: [templateId], references: [id])
  signatures      Signature[]

  @@index([protocolId])
  @@index([templateId])
  @@index([generatedAt])
  @@index([validationCode])
  @@index([documentHash])
  @@map("generated_documents")
}

// ========================================
// CATEGORIZAÇÃO DE CIDADÃOS
// ========================================

model CitizenCategory {
  id          String   @id @default(cuid())
  code        String   @unique  // Ex: PRODUTOR_RURAL, ARTISTA_LOCAL
  name        String               // Ex: "Produtor Rural", "Artista Local"
  description String?  @db.Text
  department  String               // Departamento responsável
  icon        String?              // Ícone visual
  color       String?              // Cor para UI
  active      Boolean  @default(true)

  // Array de moduleTypes que ativam esta categoria automaticamente
  triggerServices String[] // Ex: ["CADASTRO_PRODUTOR", "INSCRICAO_PROGRAMA_RURAL"]

  // Relacionamento com cidadãos
  citizens    CitizenCategoryAssignment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([active])
  @@map("citizen_categories")
}

model CitizenCategoryAssignment {
  id          String   @id @default(cuid())

  citizenId   String
  citizen     Citizen  @relation("CitizenCategories", fields: [citizenId], references: [id], onDelete: Cascade)

  categoryId  String
  category    CitizenCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Rastreabilidade - protocolo que originou a categoria
  protocolId  String?
  protocol    ProtocolSimplified? @relation("ProtocolGeneratedCategories", fields: [protocolId], references: [id], onDelete: SetNull)

  assignedAt  DateTime @default(now())
  assignedBy  String?          // Usuário que atribuiu (se manual)
  assignedByUser User? @relation("CategoryAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  active      Boolean  @default(true)
  deactivatedAt DateTime?
  deactivatedBy String?
  deactivationReason String?

  // Dados específicos desta atribuição (ex: número DAP, especialidade artística)
  metadata    Json?

  @@unique([citizenId, categoryId])
  @@index([citizenId])
  @@index([categoryId])
  @@index([protocolId])
  @@index([active])
  @@map("citizen_category_assignments")
}



// ========================================
// SISTEMA DE ASSINATURA DIGITAL MUNICIPAL
// ========================================

enum CertificateType {
  SERVER    // Servidores públicos municipais
  CITIZEN   // Cidadãos
  SYSTEM    // Sistemas/APIs
}

enum CertStatus {
  ACTIVE    // Certificado ativo
  REVOKED   // Certificado revogado
  EXPIRED   // Certificado expirado
  SUSPENDED // Certificado suspenso temporariamente
}

enum RevocationReason {
  UNSPECIFIED          // Não especificado
  KEY_COMPROMISE       // Chave privada comprometida
  CA_COMPROMISE        // Autoridade certificadora comprometida
  AFFILIATION_CHANGED  // Mudança de lotação/desligamento
  SUPERSEDED           // Substituído por novo certificado
  CESSATION            // Cessação de operação
  CERTIFICATE_HOLD     // Suspensão temporária
}

// Certificados Digitais
model DigitalCertificate {
  id              String          @id @default(cuid())
  userId          String          // FK para User (servidor ou cidadão)
  certificateType CertificateType // Tipo de certificado

  // Informações do Certificado X.509
  serialNumber    String          @unique // Número de série único
  commonName      String                  // Nome do titular (CN)
  email           String                  // Email do titular
  organization    String          @default("Prefeitura Municipal") // O=
  department      String?                 // OU=

  // Chaves Criptográficas (RSA)
  publicKey       String          @db.Text // Chave pública (formato PEM)
  privateKeyHash  String                   // Hash SHA-256 da chave privada (NUNCA armazenar a chave!)
  keySize         Int             @default(2048) // Tamanho da chave em bits (2048, 3072, 4096)

  // Validade
  issuedAt        DateTime        @default(now())
  expiresAt       DateTime                         // Geralmente 1-2 anos
  revokedAt       DateTime?
  revocationReason RevocationReason?

  // Status
  status          CertStatus      @default(ACTIVE)
  isActive        Boolean         @default(true)

  // Metadados da CA
  issuerCA        String          @default("CA-MUNICIPAL-001") // Identificador da CA emissora
  certificateChain String         @db.Text // Cadeia completa de certificação (PEM)
  thumbprint      String                   // SHA-256 fingerprint do certificado

  // Auditoria
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relacionamentos
  user            User            @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  signatures      Signature[]

  @@index([userId])
  @@index([serialNumber])
  @@index([status])
  @@index([expiresAt])
  @@index([thumbprint])
  @@map("digital_certificates")
}

// Assinaturas Digitais em Documentos
model Signature {
  id              String    @id @default(cuid())
  documentId      String    // FK para GeneratedDocument
  certificateId   String    // FK para DigitalCertificate

  // Dados da Assinatura Criptográfica
  signatureValue  String    @db.Text // Assinatura RSA em base64
  signatureHash   String             // SHA-256 do documento no momento da assinatura
  signatureAlgo   String    @default("SHA256withRSA") // Algoritmo usado

  // Metadados da Assinatura
  signedAt        DateTime  @default(now())
  ipAddress       String                      // IP do assinante
  userAgent       String?                     // User agent do navegador
  geolocation     Json?                       // Lat/Long opcional para auditoria

  // Validação
  isValid         Boolean   @default(true)    // Flag de validade
  validatedAt     DateTime?                   // Última vez que foi validada
  validationCount Int       @default(0)       // Quantas vezes foi validada

  // Auditoria
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relacionamentos
  document        GeneratedDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  certificate     DigitalCertificate   @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([certificateId])
  @@index([signedAt])
  @@index([isValid])
  @@map("signatures")
}

// Lista de Revogação de Certificados (CRL - Certificate Revocation List)
model CertificateRevocationList {
  id              String           @id @default(cuid())
  serialNumber    String                      // Número de série do certificado revogado
  certificateId   String?                     // FK opcional para DigitalCertificate
  reason          RevocationReason             // Motivo da revogação
  revokedAt       DateTime         @default(now())
  revokedBy       String                       // userId de quem revogou
  publishedAt     DateTime         @default(now())

  // Metadados
  comments        String?          @db.Text    // Comentários sobre a revogação

  // Relacionamentos
  revokedByUser   User             @relation("CRLRevokedBy", fields: [revokedBy], references: [id])

  @@index([serialNumber])
  @@index([revokedAt])
  @@index([publishedAt])
  @@map("certificate_revocation_list")
}

// ============================================
// SISTEMA DE BOT E CONVERSAÇÕES
// ============================================

// Conversação com o DigiBot
model BotConversation {
  id           String   @id @default(cuid())
  citizenId    String
  intent       String?
  confidence   Float?
  currentFlow  String?   // Fluxo atual (AGENDAR_CONSULTA, SOLICITAR_SERVICO, etc)
  flowStep     Int       @default(0) // Passo atual do fluxo
  flowData     Json?     // Dados coletados durante o fluxo
  isActive     Boolean   @default(true)
  closedAt     DateTime?
  rating       Int?      // 1-5 estrelas
  ratingComment String?  @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relacionamentos
  citizen      Citizen       @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  messages     BotMessage[]

  @@index([citizenId])
  @@index([currentFlow])
  @@index([isActive])
  @@index([createdAt])
  @@map("bot_conversations")
}

// Mensagens da conversa com o bot
model BotMessage {
  id              String   @id @default(cuid())
  conversationId  String
  role            String   // 'user' | 'bot' | 'system'
  content         String   @db.Text
  messageType     String   @default("text") // 'text' | 'card' | 'form' | 'quick_reply' | 'interactive'
  metadata        Json?    // Dados adicionais (cards, formulários, etc)
  intent          String?  // Intent reconhecida (apenas para mensagens do usuário)
  confidence      Float?   // Confiança do reconhecimento
  wasTransferred  Boolean  @default(false) // Foi transferido para humano?
  createdAt       DateTime @default(now())

  // Relacionamentos
  conversation    BotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([intent])
  @@index([createdAt])
  @@map("bot_messages")
}

// Analytics do Bot
model BotAnalytics {
  id                String   @id @default(cuid())
  date              DateTime @default(now()) @db.Date
  intent            String
  totalCount        Int      @default(0)
  successCount      Int      @default(0)  // Resolvido sem transferência
  transferCount     Int      @default(0)  // Transferido para humano
  avgConfidence     Float?
  avgResponseTime   Float?   // Tempo médio de resposta (ms)
  uniqueCitizens    Int      @default(0)

  @@unique([date, intent])
  @@index([date])
  @@index([intent])
  @@map("bot_analytics")
}

// Notificações proativas do sistema
model ProactiveNotification {
  id           String   @id @default(cuid())
  citizenId    String
  type         String   // 'protocol_expiring' | 'protocol_approved' | 'appointment_reminder' | 'suggestion'
  title        String
  message      String   @db.Text
  metadata     Json?    // Dados adicionais
  scheduledFor DateTime // Quando deve ser enviada
  sentAt       DateTime?
  isRead       Boolean  @default(false)
  readAt       DateTime?
  createdAt    DateTime @default(now())

  // Relacionamentos
  citizen      Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId])
  @@index([type])
  @@index([scheduledFor])
  @@index([sentAt])
  @@map("proactive_notifications")
}

// Uploads de arquivos durante conversas com o bot
model BotUpload {
  id             String   @id @default(cuid())
  citizenId      String
  conversationId String?
  fileName       String
  fileSize       Int
  mimeType       String
  fileUrl        String   // URL do arquivo armazenado
  uploadedAt     DateTime @default(now())
  expiresAt      DateTime? // Opcional: expiração do arquivo temporário

  // Relacionamentos
  citizen        Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId])
  @@index([conversationId])
  @@index([uploadedAt])
  @@map("bot_uploads")
}

// ========================================
// SISTEMA DE FLUXOS PROGRAMADOS DO BOT
// ========================================

// Definições de fluxos conversacionais
model FlowDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  version     String   @default("1.0.0")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false) // Fluxo padrão do sistema
  municipioId String?  // Fluxo customizado por município
  nodes       Json     // Array de nodos do fluxo
  metadata    Json?    // Tags, categorias, ícones, etc
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  // ID do usuário que criou

  // Relacionamentos
  executions  FlowExecution[]

  @@index([municipioId])
  @@index([isActive])
  @@index([isDefault])
  @@map("flow_definitions")
}

// Execuções de fluxos (estado de conversação)
model FlowExecution {
  id              String   @id @default(cuid())
  citizenId       String
  flowId          String
  conversationId  String?  // Vincula com UltraZend Messages
  currentNodeId   String   // ID do nodo atual
  state           Json     // Estado completo: dados coletados, variáveis, etc
  history         Json     // Histórico de navegação (array de node IDs)
  status          String   // ACTIVE, COMPLETED, CANCELLED, ERROR
  errorMessage    String?  @db.Text
  startedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  // Relacionamentos
  citizen         Citizen         @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  flow            FlowDefinition  @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([citizenId])
  @@index([flowId])
  @@index([conversationId])
  @@index([status])
  @@index([startedAt])
  @@map("flow_executions")
}
