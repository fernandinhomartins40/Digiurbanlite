# Environment Variables Example
# Copy this file to .env.local for development

# ===========================================
# DEVELOPMENT
# ===========================================
# URL da API Backend (desenvolvimento local)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# URL base da aplicação (usado para SEO - canonical URLs, sitemap, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===========================================
# PRODUCTION
# ===========================================
# Em produção, não defina NEXT_PUBLIC_API_URL
# O sistema usará automaticamente /api (roteado pelo Nginx)
# NEXT_PUBLIC_API_URL=/api

# URL base de produção (OBRIGATÓRIO para SEO)
# NEXT_PUBLIC_BASE_URL=https://digiurban.com.br

# Google Site Verification (opcional - para Google Search Console)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

NODE_ENV=development
