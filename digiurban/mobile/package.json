{
  "name": "digiurban-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Apps Android e iOS do DigiUrban (Capacitor abrindo o PWA de produção)",
  "scripts": {
    "web": "node scripts/copy-web.js",
    "sync": "npm run web && cap sync",
    "assets": "node scripts/make-icons.js && capacitor-assets generate --android --ios --splashBackgroundColor \"#0f6fbe\" --splashBackgroundColorDark \"#0f6fbe\"",
    "test": "node scripts/copy-web.test.js"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
