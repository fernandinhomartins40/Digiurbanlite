# Server
PORT=9002
NODE_ENV=development
LOG_LEVEL=info

# Database (usar o mesmo PostgreSQL do DigiUrban)
DATABASE_URL=postgresql://digiurban:digiurban@localhost:5432/digiurban

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_LINE_ITEMS=prices_line_items

# Redis (reutiliza o Redis do DigiUrban)
REDIS_URL=redis://localhost:6379

# Segurança — deve ser igual ao configurado no DigiUrban backend
DIGIURBAN_API_KEY=change-me-in-production

# PNCP
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_TIMEOUT_MS=30000
PNCP_RATE_LIMIT_MS=500
PNCP_MAX_PAGES_CONTRATACOES=500
PNCP_MAX_PAGES_CONTRATOS=300

# CATMAT/CATSER
CATMAT_AUTO_CLASSIFY_ENABLED=true
CATMAT_AUTO_CLASSIFY_MIN_SCORE=0.55
CATMAT_AUTO_CLASSIFY_MAX_CANDIDATES=80

# Ingestão
INGEST_SINCE_DAYS=1825
BPS_MAX_FILES_PER_RUN=6
INGEST_CRON=0 2 * * *

# Outliers
OUTLIER_METHOD=IQR
OUTLIER_IQR_K=1.5

# Playwright
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

