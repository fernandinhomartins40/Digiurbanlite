{
  "name": "@digiurban/ai",
  "version": "1.0.0",
  "description": "DigiUrban AI Platform - Servico centralizado de IA com llama.cpp e Qwen3 1.7B",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:prisma": "tsc --project tsconfig.prisma.json",
    "start": "node dist/index.js",
    "start:production": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "generate:app-context": "node ../scripts/generate-ai-admin-routes.mjs",
    "type-check": "tsc --noEmit",
    "benchmark:vps": "node scripts/benchmark-vps.js",
    "generate:lora-dataset": "node ../scripts/generate-digiurban-lora-dataset.mjs"
  },
  "keywords": [
    "ai",
    "qwen",
    "llama.cpp",
    "rag",
    "digiurban"
  ],
  "author": "DigiUrban Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "axios": "^1.13.2",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.16.3",
    "prisma": "~6.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
